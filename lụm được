  class VNTIndexedDBStorage {
    constructor(dbName = 'VNT_Lexicon_v6', storeName = 'words') {
      this.dbName = dbName;
      this.storeName = storeName;
      this.db = null;
    }

    async open() {
      if (this.db) return this.db;
      return new Promise((resolve, reject) => {
        const req = indexedDB.open(this.dbName, 1);
        req.onupgradeneeded = (e) => {
          const db = e.target.result;
          if (!db.objectStoreNames.contains(this.storeName)) {
            db.createObjectStore(this.storeName, { keyPath: 'starter' });
          }
        };
        req.onsuccess = (e) => {
          this.db = e.target.result;
          resolve(this.db);
        };
        req.onerror = (e) => reject(e);
      });
    }

    async getWords(starter) {
      try {
        const db = await this.open();
        return new Promise((resolve) => {
          const tx = db.transaction(this.storeName, 'readonly');
          const store = tx.objectStore(this.storeName);
          const req = store.get(starter);
          req.onsuccess = () => resolve(req.result ? req.result.words : null);
          req.onerror = () => resolve(null);
        });
      } catch {
        return null;
      }
    }

    async saveBatch(recordList) {
      try {
        const db = await this.open();
        return new Promise((resolve, reject) => {
          const tx = db.transaction(this.storeName, 'readwrite');
          const store = tx.objectStore(this.storeName);
          for (const item of recordList) {
            store.put(item);
          }
          tx.oncomplete = () => resolve(true);
          tx.onerror = (e) => reject(e);
        });
      } catch (e) {
        return false;
      }
    }

    async getCount() {
      try {
        const db = await this.open();
        return new Promise((resolve) => {
          const tx = db.transaction(this.storeName, 'readonly');
          const store = tx.objectStore(this.storeName);
          const req = store.count();
          req.onsuccess = () => resolve(req.result);
          req.onerror = () => resolve(0);
        });
      } catch {
        return 0;
      }
    }
  }

  class VNTTrie {
    constructor() {
      this.map = new Map();
    }

    insert(phrase) {
      if (!phrase || typeof phrase !== 'string') return;
      const clean = phrase.trim().toLowerCase().replace(/\s+/g, ' ');
      const parts = clean.split(' ');
      if (parts.length !== 2) return;
      const starter = parts[0];
      let list = this.map.get(starter);
      if (!list) {
        list = [];
        this.map.set(starter, list);
      }
      if (!list.includes(clean)) {
        list.push(clean);
      }
    }

    getWordsForStarter(starter) {
      return this.map.get(starter) || [];
    }

    size() {
      return this.map.size;
    }
  }

  class VNTLexiconEngine {
    constructor(adapter) {
      this.adapter = adapter;
      this.storage = new VNTIndexedDBStorage();
      this.trie = new VNTTrie();
      this.bannedWords = new Set(['trạng cáo', 'bin đinh']);
      this.learnedKillers = new Map(); // phrase -> { phrase, starter, ending, source } (Priority 9999)
      this.learnedEscapes = new Map(); // starter -> Array of escape phrases (Priority 8888)
      this.killerEndings = [
        'quắp', 'loét', 'hoắt', 'toét', 'bẵng', 'sượt', 'tọt', 'ngoẹo',
        'khiễng', 'khọm', 'rượi', 'choắt', 'nghẽn', 'xoẹo', 'khoèo',
        'khoằm', 'ngoạm', 'ngoắt', 'khuỵu', 'tọp', 'hoắm', 'sũng',
        'huých', 'oằn', 'nhẫy', 'rọm', 'choạng', 'trẹo', 'ngắc',
        'ngớp', 'oặt', 'dẹo', 'khựng', 'bợt', 'phỉnh', 'xoẳn',
        'toác', 'chõng'
      ];
    }

    async init() {
      // 0. Nạp tức thì toàn bộ 6,680 âm tiết tiếng Việt chuẩn từ window.VNT_LEXICON nếu có sẵn
      if (typeof window !== 'undefined' && window.VNT_LEXICON) {
        let loadedLex = 0;
        for (const [starter, endings] of Object.entries(window.VNT_LEXICON)) {
          if (Array.isArray(endings)) {
            for (const end of endings) {
              this.trie.insert(`${starter} ${end}`);
              loadedLex++;
            }
          }
        }
        this.adapter.log('LEXICON', `Đã nạp tức thì ${loadedLex} từ tiếng Việt từ VNT_LEXICON vào Trie!`);
      }

      // 1. Nạp seed ban đầu tức thì (<1ms)
      for (const [starter, phrases] of Object.entries(BOOTSTRAP_KILLER_SEED)) {
        for (const p of phrases) this.trie.insert(p);
      }

      // Khôi phục từ localStorage các từ đã học từ đối thủ Noitu.fun
      try {
        const savedKillers = JSON.parse(localStorage.getItem('VNT_LEARNED_KILLERS') || '[]');
        if (Array.isArray(savedKillers)) {
          const validKillers = [];
          for (const k of savedKillers) {
            if (k && k.phrase) {
              const p = k.phrase.trim().toLowerCase();
              if (p === 'đồng thau') continue;
              const ending = p.split(/\s+/).pop();
              if (this.killerEndings.includes(ending)) {
                this.learnedKillers.set(k.phrase, k);
                this.trie.insert(k.phrase);
                validKillers.push(k);
              }
            }
          }
          if (validKillers.length !== savedKillers.length) {
            localStorage.setItem('VNT_LEARNED_KILLERS', JSON.stringify(validKillers));
          }
        }
        const savedEscapes = JSON.parse(localStorage.getItem('VNT_LEARNED_ESCAPES') || '[]');
        if (Array.isArray(savedEscapes)) {
          for (const esc of savedEscapes) {
            if (esc && esc.starter && esc.word) {
              const list = this.learnedEscapes.get(esc.starter) || [];
              if (!list.includes(esc.word)) list.push(esc.word);
              this.learnedEscapes.set(esc.starter, list);
              this.trie.insert(esc.word);
            }
          }
        }
        const savedBanned = JSON.parse(localStorage.getItem('VNT_BANNED_WORDS') || '[]');
        if (Array.isArray(savedBanned)) {
          for (const b of savedBanned) this.bannedWords.add(b);
        }
      } catch (e) {}

      // Đồng bộ tri thức học từ server nếu có và duy trì cập nhật mỗi 10s
      this.syncLearnedKnowledgeFromServer();
      setInterval(() => {
        this.syncLearnedKnowledgeFromServer();
      }, 10000);

      // 2. Nạp IndexedDB ngầm
      setTimeout(async () => {
        try {
          const count = await this.storage.getCount();
          if (count > 200) {
            this.adapter.log('LEXICON', `IndexedDB đã có ${count} âm tiết. Đang nạp vào Trie...`);
            const db = await this.storage.open();
            const tx = db.transaction(this.storage.storeName, 'readonly');
            const req = tx.objectStore(this.storage.storeName).openCursor();
            req.onsuccess = (e) => {
              const cursor = e.target.result;
              if (cursor) {
                const words = cursor.value.words || [];
                for (const w of words) this.trie.insert(w);
                cursor.continue();
              } else {
                this.adapter.log('LEXICON', `Trie nạp hoàn tất! Tổng cộng: ${this.trie.size()} âm tiết.`);
              }
            };
          } else {
            this.syncDictionaryFromServer();
          }
        } catch (e) {
          this.adapter.warn('LEXICON', 'Lỗi nạp IndexedDB:', e);
        }
      }, 100);
    }

    async syncDictionaryFromServer() {
      const urls = [
        `${this.adapter.config.apiServer}/full_dictionary.json`,
        `${this.adapter.config.fallbackServer}/full_dictionary.json`,
        'https://vuanoitu-huyy2.vercel.app/full_dictionary.json',
        'https://raw.githubusercontent.com/quyem0508-stack/vuanoitu/main/public/full_dictionary.json',
      ];

      for (const url of urls) {
        try {
          this.adapter.log('LEXICON', `Đang tải full_dictionary.json từ: ${url}...`);
          const res = await (typeof this.adapter.fetch === 'function' ? this.adapter.fetch(url) : fetch(url));
          if (!res.ok) continue;
          const list = await res.json();
          if (!Array.isArray(list) || list.length === 0) continue;

          const grouped = new Map();
          for (const raw of list) {
            if (typeof raw !== 'string') continue;
            const clean = raw.trim().toLowerCase().replace(/\s+/g, ' ');
            const parts = clean.split(' ');
            if (parts.length === 2) {
              this.trie.insert(clean);
              let arr = grouped.get(parts[0]);
              if (!arr) {
                arr = [];
                grouped.set(parts[0], arr);
              }
              if (!arr.includes(clean)) arr.push(clean);
            }
          }

          const batch = [];
          grouped.forEach((words, starter) => {
            batch.push({ starter, words });
          });
          await this.storage.saveBatch(batch);
          this.adapter.log('LEXICON', `Đã đồng bộ & cache ${batch.length} âm tiết (${list.length} từ) vào IndexedDB!`);
          break;
        } catch (e) {}
      }
    }

    async syncLearnedKnowledgeFromServer() {
      const servers = [
        this.adapter.config.apiServer,
        this.adapter.config.fallbackServer,
        'https://vuanoitu-huyy2.vercel.app',
        this.adapter.config.localServer,
      ].filter(Boolean);

      const fetchFn = typeof this.adapter.fetch === 'function' ? this.adapter.fetch.bind(this.adapter) : fetch;

      for (const s of servers) {
        try {
          const res = await fetchFn(`${s}/api/bot/learned-knowledge`);
          if (!res.ok) continue;
          const data = await res.json();
          const knowledge = data?.knowledge || {
            newKillers: data?.killers || data?.newKillers || [],
            newEscapes: data?.escapes || data?.newEscapes || [],
            bannedWords: data?.bannedWords || [],
            customWords: data?.customWords || [],
          };
          if (knowledge && ((knowledge.newKillers && knowledge.newKillers.length > 0) || (knowledge.newEscapes && knowledge.newEscapes.length > 0) || (knowledge.bannedWords && knowledge.bannedWords.length > 0) || (knowledge.customWords && knowledge.customWords.length > 0))) {
            this.importMinedKnowledge(knowledge, true);
            this.adapter.log('LEXICON', `Đã đồng bộ tri thức từ Server (${s}): ${knowledge.newKillers?.length || 0} killers, ${knowledge.newEscapes?.length || 0} escapes, ${knowledge.customWords?.length || 0} custom, ${knowledge.bannedWords?.length || 0} banned.`);
            const kEl = document.getElementById('vnt-stat-learned-killers');
            if (kEl) kEl.textContent = `${this.learnedKillers.size}`;
            let escCount = 0;
            if (this.learnedEscapes) {
              this.learnedEscapes.forEach((arr) => { escCount += (arr?.length || 0); });
            }
            const eEl = document.getElementById('vnt-stat-learned-escapes');
            if (eEl) eEl.textContent = `${escCount}`;
            break;
          }
        } catch (e) {}
      }
    }

    importMinedKnowledge(mined, saveToStorage = true) {
      if (!mined) return { addedKillers: 0, addedEscapes: 0, addedBanned: 0 };
      let addedKillers = 0;
      let addedEscapes = 0;
      let addedBanned = 0;

      // 1. Killers (Priority 9999) - Sát thủ đối thủ từng hạ gục mình
      const killersList = mined.newKillers || mined.killers;
      if (Array.isArray(killersList)) {
        for (const k of killersList) {
          if (!k || !(k.phrase || k.word)) continue;
          const phrase = (k.phrase || k.word).trim().toLowerCase();
          if (this.bannedWords.has(phrase) || phrase === 'đồng thau') continue;
          const ending = k.ending || phrase.split(' ')[1];
          if (!this.killerEndings.includes(ending)) continue;
          if (!this.learnedKillers.has(phrase)) {
            this.learnedKillers.set(phrase, {
              phrase,
              ending,
              sourceOpponent: k.sourceOpponent || 'noitu.fun'
            });
            this.trie.insert(phrase);
            addedKillers++;
          }
        }
        if (saveToStorage) {
          try {
            const arr = Array.from(this.learnedKillers.values());
            localStorage.setItem('VNT_LEARNED_KILLERS', JSON.stringify(arr));
          } catch (e) {}
        }
      }

      // 2. Escapes (Priority 8888) - Đối thủ từng giải thành công âm này
      const escapesList = mined.newEscapes || mined.escapes;
      if (Array.isArray(escapesList)) {
        for (const esc of escapesList) {
          if (!esc || !(esc.word || esc.phrase)) continue;
          const word = (esc.word || esc.phrase).trim().toLowerCase();
          const starter = (esc.starter || word.split(' ')[0] || '').trim().toLowerCase();
          if (!starter || this.bannedWords.has(word)) continue;
          let list = this.learnedEscapes.get(starter);
          if (!list) {
            list = [];
            this.learnedEscapes.set(starter, list);
          }
          if (!list.includes(word)) {
            list.push(word);
            this.trie.insert(word);
            addedEscapes++;
          }
        }
        if (saveToStorage) {
          try {
            const flat = [];
            this.learnedEscapes.forEach((words, starter) => {
              for (const w of words) flat.push({ starter, word: w, resolvedSyllable: starter });
            });
            localStorage.setItem('VNT_LEARNED_ESCAPES', JSON.stringify(flat));
          } catch (e) {}
        }
      }

      // 3. Banned words - Từ tự sát bị lỗi/trừ tim
      if (Array.isArray(mined.bannedWords)) {
        for (const b of mined.bannedWords) {
          if (!b) continue;
          const clean = b.trim().toLowerCase();
          if (!this.bannedWords.has(clean)) {
            this.bannedWords.add(clean);
            this.learnedKillers.delete(clean);
            addedBanned++;
          }
        }
        if (saveToStorage) {
          try {
            localStorage.setItem('VNT_BANNED_WORDS', JSON.stringify(Array.from(this.bannedWords)));
          } catch (e) {}
        }
      }

      return { addedKillers, addedEscapes, addedBanned };
    }

    getCandidates(starter, usedWords = new Set()) {
      const killers = [];
      const strategicMoves = [];
      const escapes = [];
      const safes = [];
      const seen = new Set();

      // [ƯU TIÊN 1 - PRIORITY 9999]: ĐÒN SÁT THỦ KẾT LIỄU ĐỐI THỦ TỪNG DÙNG (Gậy Ông Đập Lưng Ông)
      if (this.learnedKillers && this.learnedKillers.size > 0) {
        this.learnedKillers.forEach((kData, phrase) => {
          if (this.bannedWords.has(phrase)) return;
          if (usedWords && usedWords.has(phrase)) return;
          const parts = phrase.split(' ');
          if (parts[0] === starter) {
            killers.push(phrase);
            seen.add(phrase);
          }
        });
      }

      // [ƯU TIÊN 2 - PRIORITY 8888]: ĐÒN HÓA GIẢI THẾ BÍ (ESCAPES TỪ ĐỐI THỦ NOITU.FUN)
      const learnedEsc = this.learnedEscapes.get(starter);
      if (learnedEsc && Array.isArray(learnedEsc)) {
        for (const escWord of learnedEsc) {
          if (this.bannedWords.has(escWord)) continue;
          if (usedWords && usedWords.has(escWord)) continue;
          if (!seen.has(escWord)) {
            escapes.push(escWord);
            seen.add(escWord);
          }
        }
      }

      // [ƯU TIÊN 3]: KHO TỪ ĐIỂN TRIE CHUẨN & TRA CỨU TỨC THỜI TỪ VNT_LEXICON (6,680 ÂM TIẾT)
      let fromTrie = this.trie.getWordsForStarter(starter);

      // Nếu Trie chưa nạp kịp âm tiết này, tra cứu trực tiếp từ window.VNT_LEXICON
      if (fromTrie.length === 0 && typeof window !== 'undefined' && window.VNT_LEXICON && window.VNT_LEXICON[starter]) {
        const rawList = window.VNT_LEXICON[starter];
        if (Array.isArray(rawList)) {
          for (const end of rawList) {
            const p = `${starter} ${end}`;
            if (!this.bannedWords.has(p) && (!usedWords || !usedWords.has(p))) {
              fromTrie.push(p);
              this.trie.insert(p);
            }
          }
        }
      }

      for (const phrase of fromTrie) {
        if (seen.has(phrase)) continue;
        if (this.bannedWords.has(phrase)) continue;
        if (usedWords && usedWords.has(phrase)) continue;
        seen.add(phrase);

        const parts = phrase.split(' ');
        if (parts.length !== 2) continue;
        const secondSyllable = parts[1];

        // 1. Kiểm tra nếu là âm đuôi chiếu bí tuyệt đối (0 từ nối)
        if (this.killerEndings.includes(secondSyllable)) {
          killers.push(phrase);
          continue;
        }

        // 2. Phân tích Lookahead: Đếm xem đối thủ có bao nhiêu từ để nối tiếp từ âm tiết này
        const opponentNextOptions = this.trie.getWordsForStarter(secondSyllable).filter(
          (w) => !this.bannedWords.has(w) && (!usedWords || !usedWords.has(w))
        );
        const nextCount = opponentNextOptions.length;

        if (nextCount <= 2) {
          strategicMoves.push({ phrase, nextCount });
        } else {
          safes.push({ phrase, nextCount });
        }
      }

      // Sắp xếp các nước đi bẫy và an toàn: Ưu tiên dồn đối thủ vào thế ít đường lui nhất
      strategicMoves.sort((a, b) => a.nextCount - b.nextCount);
      safes.sort((a, b) => a.nextCount - b.nextCount);

      const allSafes = [
        ...escapes,
        ...strategicMoves.map((x) => x.phrase),
        ...safes.map((x) => x.phrase),
      ];

      const bestSafe = escapes[0] || strategicMoves[0]?.phrase || allSafes[0] || killers[0] || null;

      return {
        killers,
        safes: allSafes,
        escapes,
        killer1: killers[0] || strategicMoves[0]?.phrase || escapes[0] || allSafes[0] || null,
        killer2: killers[1] || strategicMoves[1]?.phrase || escapes[1] || allSafes[1] || killers[0] || null,
        safeMove: bestSafe,
      };
    }

    banWord(word) {
      if (!word) return;
      const clean = word.trim().toLowerCase();
      this.bannedWords.add(clean);
      this.learnedKillers.delete(clean);
      try {
        localStorage.setItem('VNT_BANNED_WORDS', JSON.stringify(Array.from(this.bannedWords)));
      } catch (e) {}
    }

    parseMaskPattern(rawPattern) {
      if (!rawPattern || !rawPattern.trim()) return [];
      let cleaned = rawPattern
        .normalize('NFC')
        .toLowerCase()
        .replace(/[?*•–—.]/g, '_')
        .trim();

      if (/\s{2,}|[\/|,]/.test(cleaned)) {
        return cleaned
          .split(/(?:\s{2,}|[\/|,])+/)
          .map((g) => g.replace(/\s+/g, ''))
          .filter(Boolean);
      }

      const tokens = cleaned.split(/\s+/).filter(Boolean);
      if (tokens.length === 0) return [];
      if (tokens.every((t) => [...t].length >= 2)) {
        return tokens;
      }

      const syllables = [];
      let current = '';
      for (const token of tokens) {
        for (const ch of [...token]) {
          if (ch === '_') {
            current += '_';
          } else {
            if (current.includes('_')) {
              syllables.push(current);
              current = ch;
            } else {
              current += ch;
            }
          }
        }
      }
      if (current) syllables.push(current);
      return syllables;
    }

    solveMaskedWord(maskPattern, definitionHint = '', usedWords = new Set()) {
      const syllableMasks = this.parseMaskPattern(maskPattern);
      if (syllableMasks.length === 0) return { bestMove: null, candidates: [], syllableMasks: [] };

      const stripAccent = (c) =>
        c.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'd').toLowerCase();

      const maskArrays = syllableMasks.map((m) => [...m.normalize('NFC')]);
      const maskBaseArrays = maskArrays.map((arr) => arr.map((c) => (c === '_' ? '_' : stripAccent(c))));

      const stopWords = new Set([
        'động', 'danh', 'tính', 'phó', 'đại', 'từ', 'làm', 'cho', 'của', 'và', 'với',
        'các', 'những', 'một', 'hai', 'ba', 'có', 'được', 'bị', 'trong', 'ngoài',
        'trên', 'dưới', 'người', 'vật', 'việc', 'nói', 'khái', 'quát', 'như', 'hoặc',
        'hay', 'rất', 'thật', 'quá', 'lắm', 'bằng', 'để', 'đến', 'tới', 'ra', 'vào',
        'lên', 'xuống', 'đi', 'lại', 'theo', 'về', 'tại', 'do', 'bởi', 'vì', 'nên',
        'mà', 'thì', 'là', 'ở', 'cũng', 'vẫn', 'đã', 'đang', 'sẽ', 'không', 'chẳng'
      ]);

      const normalizedHint = (definitionHint || '').normalize('NFC').toLowerCase().trim();
      const hintTokens = normalizedHint
        ? normalizedHint.replace(/[0-9()[\]{}.,;:!?"'“”‘’\-–—/\\]/g, ' ').split(/\s+/).filter((w) => w.length >= 2)
        : [];
      const hintKeywords = Array.from(new Set(hintTokens.filter((w) => !stopWords.has(w))));
      const hintTokenSet = new Set(hintTokens);

      const hasCompound = (w1, w2) => {
        const phrase = `${w1} ${w2}`;
        const list = this.trie.getWordsForStarter(w1);
        if (list && list.includes(phrase)) return true;
        if (typeof window !== 'undefined' && window.VNT_LEXICON && Array.isArray(window.VNT_LEXICON[w1])) {
          return window.VNT_LEXICON[w1].includes(w2);
        }
        return false;
      };

      const allStarters = new Set(this.trie.starters.keys());
      if (typeof window !== 'undefined' && window.VNT_LEXICON) {
        for (const k of Object.keys(window.VNT_LEXICON)) {
          allStarters.add(k);
        }
      }

      const scored = [];
      const seen = new Set();

      for (const starter of allStarters) {
        const s1Chars = [...starter.normalize('NFC')];
        if (s1Chars.length !== maskArrays[0].length) continue;

        let s1Match = true;
        let s1Exact = 0;
        let s1Base = 0;
        for (let j = 0; j < maskArrays[0].length; j++) {
          const mc = maskArrays[0][j];
          if (mc === '_') continue;
          if (s1Chars[j] === mc) {
            s1Exact++;
          } else if (mc === maskBaseArrays[0][j] && stripAccent(s1Chars[j]) === maskBaseArrays[0][j]) {
            s1Base++;
          } else {
            s1Match = false;
            break;
          }
        }
        if (!s1Match) continue;

        let wordList = this.trie.getWordsForStarter(starter).slice();
        if (typeof window !== 'undefined' && window.VNT_LEXICON && Array.isArray(window.VNT_LEXICON[starter])) {
          for (const end of window.VNT_LEXICON[starter]) {
            wordList.push(`${starter} ${end}`);
          }
        }

        for (const phrase of wordList) {
          if (seen.has(phrase)) continue;
          seen.add(phrase);
          if (this.bannedWords.has(phrase)) continue;
          if (usedWords && usedWords.has(phrase)) continue;

          const syls = phrase.split(' ');
          if (syls.length !== maskArrays.length) continue;

          let matched = true;
          let exactCount = s1Exact;
          let baseCount = s1Base;

          for (let i = 1; i < syls.length; i++) {
            const scArr = [...syls[i].normalize('NFC')];
            const mcArr = maskArrays[i];
            const mbArr = maskBaseArrays[i];
            if (scArr.length !== mcArr.length) {
              matched = false;
              break;
            }
            for (let j = 0; j < mcArr.length; j++) {
              if (mcArr[j] === '_') continue;
              if (scArr[j] === mcArr[j]) {
                exactCount++;
              } else if (mcArr[j] === mbArr[j] && stripAccent(scArr[j]) === mbArr[j]) {
                baseCount++;
              } else {
                matched = false;
                break;
              }
            }
            if (!matched) break;
          }

          if (!matched) continue;

          let score = exactCount * 60 + baseCount * 20;
          score += Math.min(40, Math.round(Math.sqrt(wordList.length) * 2));

          if (normalizedHint) {
            const genericParticles = new Set(['thế', 'rồi', 'nữa', 'lắm', 'quá', 'hết', 'xong', 'luôn', 'ngay', 'mãi', 'hoài']);
            for (const syl of syls) {
              if (hintTokenSet.has(syl) && !stopWords.has(syl)) {
                score += 1200;
                if (normalizedHint.includes(` ${syl}`) && normalizedHint.includes('như ')) {
                  score += 600;
                }
              }
              if (genericParticles.has(syl)) continue;
              let sylBridgeCount = 0;
              for (const kw of hintKeywords) {
                if (kw === syl || genericParticles.has(kw)) continue;
                if (hasCompound(syl, kw)) {
                  sylBridgeCount++;
                  if (sylBridgeCount <= 5) score += 220;
                }
                if (hasCompound(kw, syl)) {
                  sylBridgeCount++;
                  if (sylBridgeCount <= 5) score += 220;
                }
              }
            }
          }

          scored.push({ word: phrase, score });
        }
      }

      scored.sort((a, b) => b.score - a.score || a.word.localeCompare(b.word, 'vi'));
      const candidates = scored.slice(0, 25).map((s) => s.word);
      return {
        bestMove: candidates[0] || null,
        candidates,
        syllableMasks,
      };
    }
  }

  // =========================================================================
  // LỚP 3: INPUT & HUMANIZER ENGINE (W3C InputEvent + Log-Normal Delay)
  // Bỏ hoàn toàn execCommand và không còn phụ thuộc __reactProps$
  // =========================================================================
  class VNTInputHumanizer {
    constructor(adapter) {
      this.adapter = adapter;
    }

    // Phân phối Log-Normal / Gauss qua Box-Muller Transform
    getHumanReactionDelay(baseMs = 1500, variance = 350) {
      const u1 = Math.max(1e-6, Math.random());
      const u2 = Math.random();
      const randStdNormal = Math.sqrt(-2.0 * Math.log(u1)) * Math.sin(2.0 * Math.PI * u2);
      const delay = Math.round(baseMs + randStdNormal * variance);
      return Math.max(800, Math.min(delay, 3200)); // Clamp an toàn 0.8s - 3.2s
    }

    // Chuẩn hóa W3C & React 18: set native value + reset value tracker + InputEvent + ChangeEvent
    dispatchNativeInput(inputEl, text) {
      if (!inputEl) return;
      const tracker = inputEl._valueTracker;
      if (tracker) {
        tracker.setValue('');
      }

      const nativeSetter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value')?.set;
      if (nativeSetter) {
        nativeSetter.call(inputEl, text);
      } else {
        inputEl.value = text;
      }

      const inputEvent = new InputEvent('input', {
        bubbles: true,
        cancelable: true,
        inputType: 'insertText',
        data: text,
      });
      inputEl.dispatchEvent(inputEvent);
      inputEl.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
      inputEl.dispatchEvent(new Event('change', { bubbles: true, composed: true }));
    }

    // Nhấp chuột đa tầng hỗ trợ React 18 Synthetic Events & Fiber onClick
    triggerButtonClick(btn) {
      if (!btn || btn.disabled) return false;
      const opts = { bubbles: true, cancelable: true, view: window };
      btn.dispatchEvent(new PointerEvent('pointerdown', opts));
      btn.dispatchEvent(new MouseEvent('mousedown', opts));
      btn.dispatchEvent(new PointerEvent('pointerup', opts));
      btn.dispatchEvent(new MouseEvent('mouseup', opts));
      btn.click();

      const reactKey = Object.keys(btn).find((k) => k.startsWith('__reactProps$') || k.startsWith('__reactEvents$'));
      if (reactKey && btn[reactKey]?.onClick) {
        try {
          btn[reactKey].onClick({ preventDefault: () => {}, stopPropagation: () => {} });
        } catch (e) {}
      }
      return true;
    }

    // Gửi phím Enter theo chuẩn DOM và React Event Handler
    triggerEnter(inputEl) {
      if (!inputEl) return;
      const enterOpts = { key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true, cancelable: true, composed: true };
      inputEl.dispatchEvent(new KeyboardEvent('keydown', enterOpts));
      inputEl.dispatchEvent(new KeyboardEvent('keypress', enterOpts));
      inputEl.dispatchEvent(new KeyboardEvent('keyup', enterOpts));

      const reactKey = Object.keys(inputEl).find((k) => k.startsWith('__reactProps$') || k.startsWith('__reactEvents$'));
      if (reactKey && inputEl[reactKey]?.onKeyDown) {
        try {
          inputEl[reactKey].onKeyDown({ key: 'Enter', code: 'Enter', keyCode: 13, which: 13, preventDefault: () => {}, stopPropagation: () => {} });
        } catch (e) {}
      }
    }

    // Mô phỏng gõ người thật với keystroke jitter & submit đa tầng
    async simulateTyping(inputEl, prefix, targetSecondWord, typingSpeedMs = 50) {
      if (!inputEl) return;
      inputEl.focus();

      const cleanPrefix = (prefix || '').trim();
      const basePrefix = cleanPrefix ? `${cleanPrefix} ` : '';
      this.dispatchNativeInput(inputEl, basePrefix);
      await new Promise((r) => setTimeout(r, basePrefix ? 60 : 30));

      let currentVal = basePrefix;
      const chars = targetSecondWord.split('');

      for (let i = 0; i < chars.length; i++) {
        currentVal += chars[i];
        this.dispatchNativeInput(inputEl, currentVal);

        const jitter = Math.round((Math.random() - 0.5) * 25);
        const delay = Math.max(30, typingSpeedMs + jitter);
        await new Promise((r) => setTimeout(r, delay));
      }

      // Đảm bảo giá trị cuối cùng được gán chuẩn xác
      this.dispatchNativeInput(inputEl, currentVal);
      await new Promise((r) => setTimeout(r, 80));

      // 1. Gửi phím Enter (KeyboardEvent hoàn chỉnh)
      this.triggerEnter(inputEl);

      // 2. Tìm nút Gửi (Nút submit/send của Noitu.fun)
      const submitBtn = inputEl.parentElement?.querySelector('button') ||
                        inputEl.closest('div')?.querySelector('button') ||
                        inputEl.closest('form')?.querySelector('button') ||
                        document.querySelector('button[aria-label*="Gửi"], button[aria-label*="gửi"]') ||
                        document.querySelector('button[class*="word-link-answer-input_btn"]') ||
                        document.querySelector('button[class*="submitBtn"]') ||
                        document.querySelector('button[type="submit"]');

      if (submitBtn && !submitBtn.disabled) {
        this.triggerButtonClick(submitBtn);
      }

      // 3. Fallback form requestSubmit
      try {
        inputEl.closest('form')?.requestSubmit?.();
      } catch (e) {}

      // 4. Kiểm tra lại sau 150ms: Nếu từ vẫn kẹt trong ô nhập thì nhấp lại
      await new Promise((r) => setTimeout(r, 150));
      if (inputEl.value && inputEl.value.trim().toLowerCase() === currentVal.trim().toLowerCase()) {
        if (submitBtn && !submitBtn.disabled) {
          this.triggerButtonClick(submitBtn);
        }
        this.triggerEnter(inputEl);
      }
    }
  }

  // =========================================================================
  // BỘ ĐỊNH DẠNG BÁO CÁO VÁN ĐẤU & TỰ ĐỘNG TẢI VỀ MÁY CHO USERSCRIPT
  // =========================================================================
  function triggerDownloadTxt(filename, content) {
    try {
      const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 2000);
    } catch (e) {
      console.warn('Lỗi download file:', e);
    }
  }

  function detectMatchOutcome(container = document.body, lastActivePlayer = 'opponent', matchContext = null) {
    const modal = document.querySelector('[class*="game-result-modal"], [class*="result-modal"]');

    // 1. Nếu có modal kết quả trận đấu hiển thị trên màn hình:
    if (modal) {
      const modalText = (modal.innerText || modal.textContent || '').toLowerCase();
      const modalHtml = modal.innerHTML.toLowerCase();
      const titleEl = modal.querySelector('h1, h2, h3, h4, [class*="title"], [class*="header"], [class*="result"]');
      const titleText = (titleEl ? (titleEl.textContent || '') : '').toLowerCase();

      // Kiểm tra Thất Bại trước (Tránh dính chữ "chiến thắng" trong bảng thống kê)
      if (
        titleText.includes('thất bại') || titleText.includes('thua') || titleText.includes('defeat') ||
        modalText.includes('thất bại') || modalText.includes('bạn thua') || modalText.includes('bạn bị xử thua') || modalText.includes('thua cuộc') ||
        modalHtml.includes('game-result-modal_lose') || modalHtml.includes('resultmodal_lose') || modalHtml.includes('defeat') || modalHtml.includes('skull') ||
        (modalText.includes('-') && (modalText.includes('elo') || modalText.includes('điểm')))
      ) {
        return { result: 'DEFEAT', reason: 'Modal hiển thị Thất Bại (Bị trừ điểm / Hết giờ / Đối thủ hạ gục)' };
      }

      // Kiểm tra Chiến Thắng:
      if (
        titleText.includes('chiến thắng') || titleText.includes('thắng') || titleText.includes('victory') ||
        modalText.includes('chiến thắng') || modalText.includes('bạn thắng') || modalText.includes('thắng cuộc') || modalText.includes('đối thủ đã rời') || modalText.includes('đối thủ đã thoát') ||
        modalHtml.includes('game-result-modal_win') || modalHtml.includes('resultmodal_win') || modalHtml.includes('victory') || modalHtml.includes('trophy') || modalHtml.includes('crown') ||
        (modalText.includes('+') && (modalText.includes('elo') || modalText.includes('điểm')))
      ) {
        return { result: 'VICTORY', reason: 'Modal hiển thị Chiến Thắng' };
      }
    }

    // 2. Logic xác thực theo dữ liệu lượt đi thực tế (Deterministic Turn Telemetry)
    if (matchContext) {
      const allMoves = matchContext.allMoves || [];
      const turnLogs = matchContext.turnLogs || [];

      // Kiểm tra turnLogs: nếu lượt cuối cùng bot không trả lời được từ của đối thủ -> Chắc chắn Thua!
      if (turnLogs.length > 0) {
        const lastTurn = turnLogs[turnLogs.length - 1];
        if (!lastTurn.botResponse || lastTurn.botResponse === '—' || lastTurn.botResponse.trim() === '') {
          return { result: 'DEFEAT', reason: `Bí từ trước đòn "${lastTurn.opponentWord}" của đối thủ (Bot không đưa ra được từ nối)` };
        }
      }

      // Kiểm tra allMoves: ai là người nối được từ hợp lệ cuối cùng?
      if (allMoves.length > 0) {
        const lastMove = allMoves[allMoves.length - 1];
        if (lastMove.side && (lastMove.side.includes('Bot') || lastMove.side.includes('bot'))) {
          return { result: 'VICTORY', reason: `Bot đã nối thành công từ cuối "${lastMove.word}", đối thủ không thể phản đòn` };
        }
        if (lastMove.side && (lastMove.side.includes('Đối thủ') || lastMove.side.includes('opponent'))) {
          return { result: 'DEFEAT', reason: `Đối thủ ra đòn "${lastMove.word}", Bot không trả lời được` };
        }
      }

      if (matchContext.botTurnCount === 0 && matchContext.lastOpponentWord) {
        return { result: 'DEFEAT', reason: `Bí từ ngay hiệp đầu trước từ "${matchContext.lastOpponentWord}"` };
      }
    }

    // 3. Kiểm tra thông báo kết thúc chỉ trong khu vực sàn đấu (#main-wrapper)
    const gameArea = document.querySelector('#main-wrapper');
    if (gameArea) {
      const areaText = (gameArea.innerText || '').toLowerCase();
      if (areaText.includes('bạn bị xử thua') || areaText.includes('bạn đã hết giờ') || areaText.includes('bạn thua')) {
        return { result: 'DEFEAT', reason: 'Thông báo xử thua trên sàn đấu' };
      }
      if (areaText.includes('đối thủ đã thoát') || areaText.includes('đối thủ đã rời') || areaText.includes('đối thủ hết giờ')) {
        return { result: 'VICTORY', reason: 'Đối thủ đã thoát / hết giờ' };
      }
    }

    // 4. Fallback mặc định theo người cầm lượt
    if (lastActivePlayer === 'bot') {
      return { result: 'DEFEAT', reason: 'Hết thời gian lượt đi của Bot' };
    }
    return { result: 'VICTORY', reason: 'Đối thủ không phản hồi' };
  }

