        <!-- NÚT NẠP LOG HUẤN LUYỆN AI (GẬY ÔNG ĐẬP LƯNG ÔNG) -->
        <div style="display:flex;flex-direction:column;gap:4px;margin-top:2px;">
          <input type="file" id="vnt-import-log-file-input" accept=".json,.txt" style="display:none;" />
          <button id="vnt-import-log-btn" style="width:100%;padding:6px 8px;background:linear-gradient(135deg,#9333ea,#7e22ce);color:white;border:1px solid #c084fc;border-radius:6px;font-size:10px;font-weight:bold;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:4px;" title="Chọn file JSON/TXT ván đấu để quét danh sách từ trước khi bấm Tải Lên">
            📂 Chọn File Log Quét Từ
          </button>
          <div id="vnt-import-preview-box" style="display:none;flex-direction:column;gap:4px;padding:6px;background:#27272a;border:1px solid #f59e0b;border-radius:6px;font-size:10px;">
            <div id="vnt-import-preview-text" style="color:#fde68a;font-weight:bold;line-height:1.3;"></div>
            <div style="display:flex;gap:4px;">
              <button id="vnt-confirm-upload-btn" style="flex:1;padding:5px 6px;background:#f59e0b;color:#000;border:none;border-radius:4px;font-size:10px;font-weight:bold;cursor:pointer;">
                ☁️ Tải Lên Từ
              </button>
              <button id="vnt-cancel-upload-btn" style="padding:5px 6px;background:#3f3f46;color:#fff;border:none;border-radius:4px;font-size:10px;cursor:pointer;">
                Hủy
              </button>
            </div>
          </div>
        </div>

        <button id="vnt-open-monitor-btn" style="width:100%;padding:6px 8px;background:linear-gradient(135deg,#0284c7,#0369a1);color:white;border:none;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;margin-top:2px;">
          📡 Mở Web Giám Sát Live
        </button>
      </div>
    `;

    Object.assign(hud.style, {
      position: 'fixed',
      bottom: '24px',
      right: '24px',
      width: '240px',
      background: '#18181b',
      border: '1px solid #27272a',
      borderRadius: '12px',
      boxShadow: '0 10px 25px -5px rgba(0,0,0,0.5)',
      zIndex: '999999',
      fontFamily: 'system-ui, -apple-system, sans-serif',
      transition: 'opacity 0.2s',
    });

    document.body.appendChild(hud);

    // Xử lý kéo thả HUD
    const header = hud.querySelector('#vnt-header');
    let isDragging = false, startX, startY, initX, initY;
    header.addEventListener('mousedown', (e) => {
      isDragging = true;
      startX = e.clientX;
      startY = e.clientY;
      const rect = hud.getBoundingClientRect();
      initX = rect.left;
      initY = rect.top;
      e.preventDefault();
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      hud.style.left = `${initX + (e.clientX - startX)}px`;
      hud.style.top = `${initY + (e.clientY - startY)}px`;
      hud.style.bottom = 'auto';
      hud.style.right = 'auto';
    });

    window.addEventListener('mouseup', () => { isDragging = false; });

    // Thu nhỏ / mở rộng
    const minBtn = hud.querySelector('#vnt-min-btn');
    const body = hud.querySelector('#vnt-body');
    minBtn.addEventListener('click', () => {
      const isHidden = body.style.display === 'none';
      body.style.display = isHidden ? 'flex' : 'none';
      minBtn.textContent = isHidden ? '—' : '+';
    });

    // Cập nhật tiến độ 30 ván hiện tại từ localStorage
    try {
      const c = parseInt(localStorage.getItem('vnt_match_count_30') || localStorage.getItem('vnt_match_count_10') || '0', 10);
      const el = hud.querySelector('#vnt-stat-progress-30') || hud.querySelector('#vnt-stat-progress-10');
      if (el) el.textContent = `${c % 30}/30`;
      const chk = hud.querySelector('#vnt-toggle-auto30');
      if (chk) chk.checked = localStorage.getItem('vnt_auto_download_30_enabled') !== 'false';
    } catch (e) {}

    
    const updateLearnedStats = () => {
      const activeLex = lexiconEngine || window.VNT_LEXICON;
      if (activeLex) {
        const kEl = hud.querySelector('#vnt-stat-learned-killers');
        if (kEl) kEl.textContent = `${activeLex.learnedKillers?.size || 0}`;
        let escCount = 0;
        if (activeLex.learnedEscapes) {
          activeLex.learnedEscapes.forEach((arr) => { escCount += (arr?.length || 0); });
        }
        const eEl = hud.querySelector('#vnt-stat-learned-escapes');
        if (eEl) eEl.textContent = `${escCount}`;
      }
    };
    updateLearnedStats();

    // Checkbox events
    hud.querySelector('#vnt-toggle-auto').addEventListener('change', (e) => {
      adapter.saveConfig('autoPlay', e.target.checked);
      const dot = hud.querySelector('#vnt-status-dot');
      if (dot) {
        dot.style.background = e.target.checked ? '#10b981' : '#71717a';
        dot.style.boxShadow = e.target.checked ? '0 0 8px #10b981' : 'none';
      }
    });
    hud.querySelector('#vnt-toggle-killer').addEventListener('change', (e) => {
      adapter.saveConfig('prioritizeKillers', e.target.checked);
    });
    hud.querySelector('#vnt-toggle-requeue').addEventListener('change', (e) => {
      adapter.saveConfig('autoRequeue', e.target.checked);
    });
    hud.querySelector('#vnt-toggle-auto30')?.addEventListener('change', (e) => {
      localStorage.setItem('vnt_auto_download_30_enabled', e.target.checked ? 'true' : 'false');
    });

    // Xử lý nút Tải Ván Này (.TXT)
    hud.querySelector('#vnt-export-last-btn')?.addEventListener('click', () => {
      const last = window.VNT_LAST_MATCH_ARCHIVE;
      if (!last) {
        alert('Chưa hoàn thành ván đấu nào trong phiên này để xuất!');
        return;
      }
      const rawRes = last.result || last.matchMetadata?.result || 'UNKNOWN';
      const isWin = rawRes.includes('VICTORY') || rawRes.includes('THẮNG') || rawRes.includes('WIN');
      const filename = `tran_${Date.now()}_${isWin ? 'THANG' : 'THUA'}.txt`;
      const txt = formatSingleMatchReport(last);
      triggerDownloadTxt(filename, txt);
    });

    // Xử lý nút Tải 30 Ván Gần Nhất
    (hud.querySelector('#vnt-export-30-btn') || hud.querySelector('#vnt-export-10-btn'))?.addEventListener('click', () => {
      try {
        const raw = localStorage.getItem('vnt_match_history_full');
        const list = raw ? JSON.parse(raw) : [];
        if (list.length === 0) {
          alert('Chưa có ván đấu nào trong lịch sử để xuất!');
          return;
        }
        const last30 = list.slice(0, 30);
        const txt30 = format30MatchesReport(last30);
        triggerDownloadTxt(`tong_hop_30_van_dau_${Date.now()}.txt`, txt30);
      } catch (err) {
        alert('Lỗi đọc dữ liệu ván đấu!');
      }
    });

    // Xử lý nút Xuất Lịch Sử Toàn Bộ
    hud.querySelector('#vnt-export-all-btn')?.addEventListener('click', () => {
      try {
        const raw = localStorage.getItem('vnt_match_history_full');
        const list = raw ? JSON.parse(raw) : [];
        if (list.length === 0) {
          alert('Chưa có lịch sử ván đấu nào được ghi lại.');
          return;
        }
        const summaryTxt = format10MatchesReport(list);
        triggerDownloadTxt(`lich_su_${list.length}_van_dau.txt`, summaryTxt);
      } catch (err) {
        alert('Lỗi đọc dữ liệu lịch sử!');
      }
    });

    // Nút Nạp Log Học Đòn trực tiếp trên Floating HUD (Chỉ quét trước, bấm nút Tải Lên mới nạp)
    const importInput = hud.querySelector('#vnt-import-log-file-input');
    const importBtn = hud.querySelector('#vnt-import-log-btn');
    const previewBox = hud.querySelector('#vnt-import-preview-box');
    const previewText = hud.querySelector('#vnt-import-preview-text');
    const confirmUploadBtn = hud.querySelector('#vnt-confirm-upload-btn');
    const cancelUploadBtn = hud.querySelector('#vnt-cancel-upload-btn');
    let pendingMinedData = null;
    let pendingLogsCount = 0;

    if (importBtn && importInput) {
      importBtn.addEventListener('click', () => {
        importInput.click();
      });

      importInput.addEventListener('change', (e) => {
        const files = e.target.files;
        if (!files || files.length === 0) return;
        const file = files[0];
        const reader = new FileReader();
        reader.onload = async (evt) => {
          try {
            const content = evt.target.result;
            let logs = [];
            if (file.name.endsWith('.json')) {
              try {
                const parsed = JSON.parse(content);
                logs = Array.isArray(parsed) ? parsed : [parsed];
              } catch {
                alert('Tệp JSON không hợp lệ!');
                return;
              }
            } else {
              logs = parseTxtMatchLogs(content, file.name);
            }

            if (!logs || logs.length === 0) {
              alert('Không tìm thấy dữ liệu ván đấu nào trong tệp!');
              return;
            }

            pendingMinedData = parseAndMineMatchLogs(logs);
            pendingLogsCount = logs.length;

            if (previewBox && previewText) {
              previewText.innerHTML = `Đã quét ${pendingLogsCount} ván: +${pendingMinedData.newKillers.length} Sát thủ, +${pendingMinedData.newEscapes.length} Phá bí.<br/><span style="color:#a1a1aa;font-weight:normal;">Bấm "☁️ Tải Lên Từ" để xác nhận nạp!</span>`;
              previewBox.style.display = 'flex';
            }
          } catch (err) {
            alert('Lỗi phân tích tệp log: ' + err.message);
          } finally {
            importInput.value = '';
          }
        };
        reader.readAsText(file);
      });

      if (confirmUploadBtn) {
        confirmUploadBtn.addEventListener('click', () => {
          if (!pendingMinedData) return;
          const mined = pendingMinedData;
          lexiconEngine.importMinedKnowledge(mined, true);

          const kEl = hud.querySelector('#vnt-stat-learned-killers');
          if (kEl) kEl.textContent = `${lexiconEngine.learnedKillers.size}`;
          let escCount = 0;
          if (lexiconEngine.learnedEscapes) {
            lexiconEngine.learnedEscapes.forEach((arr) => { escCount += (arr?.length || 0); });
          }
          const eEl = hud.querySelector('#vnt-stat-learned-escapes');
          if (eEl) eEl.textContent = `${escCount}`;

          const actionEl = hud.querySelector('#vnt-last-action');
          if (actionEl) {
            actionEl.innerHTML = `<span style="color:#c084fc;font-weight:bold;">☁️ Đã tải lên: +${mined.newKillers.length} sát thủ, +${mined.newEscapes.length} cứu sinh!</span>`;
          }

          try {
            const fetchFn = typeof adapter.fetch === 'function' ? adapter.fetch.bind(adapter) : fetch;
            fetchFn(`${adapter.config.apiServer}/api/bot/import-mined-knowledge`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                newKillers: mined.newKillers,
                newEscapes: mined.newEscapes,
                bannedWords: mined.bannedWords,
                source: 'noitu.fun'
              })
            }).catch(() => {});
          } catch (err) {}

          if (previewBox) previewBox.style.display = 'none';
          pendingMinedData = null;
          alert(`☁️ Đã tải lên thành công ${pendingLogsCount} ván đấu!\n+ ${mined.newKillers.length} Đòn sát thủ (Priority 9999)\n+ ${mined.newEscapes.length} Đòn cứu sinh (Priority 8888)`);
        });
      }

      if (cancelUploadBtn) {
        cancelUploadBtn.addEventListener('click', () => {
          pendingMinedData = null;
          if (previewBox) previewBox.style.display = 'none';
        });
      }
    }

    // Nút mở live monitor
    hud.querySelector('#vnt-open-monitor-btn')?.addEventListener('click', () => {
      const server = adapter.config.apiServer || 'https://www.vuanoitu.duckdns.org';
      window.open(`${server}/?tab=live_monitor`, '_blank');
    });
  }

  // =========================================================================
  // BOOTSTRAP HỆ THỐNG V6.0 TRÊN USERSCRIPT
  // =========================================================================
  async function bootstrap() {
    const adapter = new VNTAdapter();
    await adapter.init();

    const lexiconEngine = new VNTLexiconEngine(adapter);
    await lexiconEngine.init();
    window.VNT_LEXICON = lexiconEngine;

    const humanizer = new VNTInputHumanizer(adapter);
    const gateway = new VNTGateway(adapter);
    const fsm = new GameStateMachine(adapter, lexiconEngine, humanizer, gateway);

    createFloatingHUD(adapter, lexiconEngine);

    // Heartbeat 10s qua BFF Gateway
    const sendPulse = () => {
      try {
        const inputEl = fsm.getGameContainer().querySelector('input[type="text"]');
        const status = (inputEl && !inputEl.disabled) ? 'in_match' : 'lobby';
        gateway.sendHeartbeat({
          status,
          roomCode: window.location.pathname,
          currentOpponent: fsm.matchContext.lastOpponentWord ? 'active' : '',
          matchResult: fsm.matchContext.lastHeartbeatResult,
        });
        fsm.matchContext.lastHeartbeatResult = null;
      } catch (e) {}
    };
    sendPulse();
    setInterval(sendPulse, 10000);

    // DOM Mutation Observer (Event-driven)
    let debounceTimer = null;
    const scheduleDOMCheck = () => {
      if (fsm.isLocked || fsm.state === BotState.THINKING || fsm.state === BotState.EXECUTING) {
        return;
      }
      if (debounceTimer) return;
      debounceTimer = setTimeout(() => {
        debounceTimer = null;
        fsm.evaluateDOM();
      }, 50);
    };

    const targetNode = document.querySelector('#main-wrapper') || document.body;
    const observer = new MutationObserver(() => scheduleDOMCheck());
    observer.observe(targetNode, { childList: true, subtree: true, characterData: true });

    // Watchdog Deadman Switch (1.5s)
    setInterval(() => {
      if (fsm.isLocked && Date.now() - fsm.stateEnteredTimestamp > 18000) {
        adapter.warn('WATCHDOG', 'FSM bị kẹt > 16s. Tự động giải phóng khóa!');
        fsm.isLocked = false;
        fsm.transition(BotState.OPPONENT_TURN);
      }
      scheduleDOMCheck();
    }, 1500);

    // SPA Navigation Monitor & Beacon Flush
    const handleSpaNav = () => {
      const currentUrl = window.location.href;
      if (currentUrl !== fsm.lastObservedUrl) {
        fsm.lastObservedUrl = currentUrl;
        if (!fsm.matchContext.isArchived && (fsm.matchContext.botTurnCount > 0 || fsm.matchContext.turnLogs.length > 0)) {
          fsm.flushMatchArchive('NAVIGATE');
        }
        fsm.resetMatchContext();
        fsm.transition(BotState.IDLE);
        scheduleDOMCheck();
      }
    };
    window.addEventListener('popstate', handleSpaNav);
    const origPush = history.pushState;
    history.pushState = function (...args) {
      const res = origPush.apply(this, args);
      handleSpaNav();
      return res;
    };
    const origReplace = history.replaceState;
    history.replaceState = function (...args) {
      const res = origReplace.apply(this, args);
      handleSpaNav();
      return res;
    };

    // Beacon Flush khi đóng tab hoặc rời trang
    window.addEventListener('beforeunload', () => {
      if (!fsm.matchContext.isArchived && (fsm.matchContext.botTurnCount > 0 || fsm.matchContext.turnLogs.length > 0)) {
        fsm.flushMatchArchive('UNLOAD');
      }
    });

    fsm.evaluateDOM();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootstrap);
  } else {
    bootstrap();
  }
})();
