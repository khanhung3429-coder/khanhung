  function normalizePhrase(raw) {
    if (!raw || typeof raw !== 'string') return '';
    return raw
      .trim()
      .toLowerCase()
      .normalize('NFC')
      .replace(/[,\.;:!\?"'\(\)\[\]\{\}]/g, '')
      .replace(/\s+/g, ' ');
  }

  function extractTurnsFromMatch(match) {
    const turns = [];
    if (Array.isArray(match.danhSachTuDaNoi) && match.danhSachTuDaNoi.length > 0) {
      for (const item of match.danhSachTuDaNoi) {
        const opp = normalizePhrase(item.tuDoiThu || item.opponentWord || '');
        const bot = normalizePhrase(item.botDapTu || item.botResponse || item.botWord || '');
        const isErr = Boolean(item.isError || (item.chienThuat || '').toLowerCase().includes('lỗi') || (item.chienThuat || '').toLowerCase().includes('từ chối'));
        turns.push({
          opponentWord: opp,
          botResponse: bot === '—' ? '' : bot,
          isError: isErr,
          strategy: item.chienThuat || item.strategy,
        });
      }
      return turns;
    }

    const turnLogs = match.turnLogs || match.rawTelemetry?.turnLogs;
    if (Array.isArray(turnLogs) && turnLogs.length > 0) {
      for (const item of turnLogs) {
        const opp = normalizePhrase(item.opponentWord || item.tuDoiThu || '');
        const bot = normalizePhrase(item.botResponse || item.botWord || item.botDapTu || '');
        const isErr = Boolean(item.isError || (item.strategy || '').toLowerCase().includes('error'));
        turns.push({
          opponentWord: opp,
          botResponse: bot === '—' ? '' : bot,
          isError: isErr,
          strategy: item.strategy || item.chienThuat,
        });
      }
      return turns;
    }

    const allMoves = match.allMoves || match.rawTelemetry?.allMoves;
    if (Array.isArray(allMoves) && allMoves.length > 0) {
      let currentOpp = '';
      for (const move of allMoves) {
        const isOpp = move.side === 'opponent' || (move.side || '').toLowerCase().includes('đối thủ');
        const word = normalizePhrase(move.word || '');
        if (isOpp) {
          currentOpp = word;
        } else {
          turns.push({
            opponentWord: currentOpp,
            botResponse: word,
            isError: Boolean(move.isError),
            strategy: move.strategy,
          });
          currentOpp = '';
        }
      }
      if (currentOpp) {
        turns.push({ opponentWord: currentOpp, botResponse: '' });
      }
      return turns;
    }

    return turns;
  }

  function isMatchLoss(match) {
    const resultStr = String(
      match.result ||
      match.ketQua ||
      match.resultEnglish ||
      match.rawTelemetry?.result ||
      match.matchMetadata?.result ||
      ''
    ).toUpperCase();

    return (
      resultStr.includes('DEFEAT') ||
      resultStr.includes('LOSS') ||
      resultStr.includes('THUA') ||
      resultStr.includes('THẤT BẠI')
    );
  }

  // ─── BỘ BÓC TÁCH LOG ĐỊNH DẠNG VĂN BẢN TXT (HỖ TRỢ TRAN_*.TXT & 10/20/30 VÁN) ───
  function parseTxtMatchLogs(content, fileName = '') {
    if (!content || typeof content !== 'string') return [];

    const isMultiMatch = /\[VÁN\s*#\d+/i.test(content) || (content.match(/NHẬT KÝ CHI TIẾT VÁN ĐẤU/gi) || []).length > 1;
    const rawSections = [];

    if (isMultiMatch) {
      if (/\[VÁN\s*#\d+/i.test(content)) {
        const parts = content.split(/(?=\[VÁN\s*#\d+)/i);
        for (const p of parts) {
          if (/\[VÁN\s*#\d+/i.test(p)) rawSections.push(p);
        }
      } else {
        const parts = content.split(/(?================================================================================\s*\r?\n\s*NHẬT KÝ CHI TIẾT VÁN ĐẤU)/i);
        for (const p of parts) {
          if (p.includes('KẾT QUẢ VÁN ĐẤU') || p.includes('Lượt |') || p.includes('STT |')) rawSections.push(p);
        }
      }
    }

    if (rawSections.length === 0) {
      rawSections.push(content);
    }

    const matches = [];

    for (let sIdx = 0; sIdx < rawSections.length; sIdx++) {
      const sec = rawSections[sIdx];
      const lines = sec.split(/\r?\n/);

      let result = '';
      let roomCode = '';
      let fatalWord = '';
      let opponentName = 'Cao thủ Noitu';
      const turnLogs = [];
      const allMoves = [];

      // Phân tích thông tin ván đấu
      for (const line of lines) {
        const trimmed = line.trim();
        if (/KẾT QUẢ VÁN ĐẤU/i.test(trimmed) || /\[VÁN\s*#\d+.*\]\s*-\s*/i.test(trimmed)) {
          if (trimmed.includes('THUA') || trimmed.includes('DEFEAT') || trimmed.includes('THẤT BẠI') || trimmed.includes('❌')) {
            result = 'DEFEAT';
          } else if (trimmed.includes('THẮNG') || trimmed.includes('VICTORY') || trimmed.includes('WIN') || trimmed.includes('🏆')) {
            result = 'VICTORY';
          }
        }
        if (/Phòng(?:\s*đấu)?:\s*(.+)/i.test(trimmed)) {
          const m = trimmed.match(/Phòng(?:\s*đấu)?:\s*(.+)/i);
          if (m) roomCode = m[1].trim();
        }
        if (/Đối thủ:\s*(.+)/i.test(trimmed)) {
          const m = trimmed.match(/Đối thủ:\s*(.+)/i);
          if (m) opponentName = m[1].trim();
        }
        if (/Tình huống(?: kết thúc)?:\s*(.+)/i.test(trimmed)) {
          const m = trimmed.match(/Tình huống(?: kết thúc)?:\s*(.+)/i);
          if (m) fatalWord = m[1].trim();
        }
      }

      if (!result && fileName) {
        const upper = fileName.toUpperCase();
        if (upper.includes('THUA') || upper.includes('DEFEAT') || upper.includes('LOSS')) result = 'DEFEAT';
        else if (upper.includes('THANG') || upper.includes('WIN') || upper.includes('VICTORY')) result = 'VICTORY';
      }

      let isAllMovesTable = false;
      let isTurnLogsTable = false;

      for (let i = 0; i < lines.length; i++) {
        const line = lines[i].trim();
        if (!line) continue;

        // 1. DẠNG DANH SÁCH: #1 [Đối thủ]: "từ" [STRATEGY] (1234ms)
        const listMatch = line.match(/^#?(\d+)\s*\[([^\]]+)\]:\s*"([^"]+)"(?:\s*\[([^\]]*)\])?(?:\s*\(([^)]*)\))?/);
        if (listMatch) {
          const order = parseInt(listMatch[1], 10);
          const sideRaw = listMatch[2].trim();
          const wordRaw = listMatch[3].trim();
          const strat = listMatch[4]?.trim() || '';
          const latStr = listMatch[5]?.trim() || '';
          const lat = parseInt(latStr, 10) || undefined;

          const isBot = sideRaw.toLowerCase().includes('bot') || sideRaw.toLowerCase().includes('mình');
          const isErrorOrTimeout = wordRaw.includes('❌') || wordRaw.toLowerCase().includes('bí từ') || wordRaw.toLowerCase().includes('hết giờ') || wordRaw.toLowerCase().includes('đầu hàng');

          if (isErrorOrTimeout) {
            if (isBot && !result) result = 'DEFEAT';
            if (!isBot && !result) result = 'VICTORY';
          } else {
            allMoves.push({
              order,
              side: isBot ? 'Bot (mình)' : 'Đối thủ',
              word: wordRaw,
              strategy: strat,
              latencyMs: lat,
            });
          }
          continue;
        }

        // 2. DẠNG MŨI TÊN: Lượt 1: Đối thủ: "từ 1" ➔ Bot: "từ 2"
        const arrowMatch = line.match(/Lượt\s*(\d+)[:.]\s*Đối thủ[:\s]*"([^"]*)"\s*➔\s*Bot[:\s]*"([^"]*)"(?:\s*\[([^\]]*)\])?/i);
        if (arrowMatch) {
          const oppWord = arrowMatch[2].trim();
          const botWord = arrowMatch[3].trim();
          const strat = arrowMatch[4]?.trim() || '';

          const cleanOpp = (oppWord === '—' || oppWord.includes('❌')) ? '' : oppWord;
          const cleanBot = (botWord === '—' || botWord.includes('❌')) ? '' : botWord;

          if (cleanOpp || cleanBot) {
            turnLogs.push({
              opponentWord: cleanOpp,
              botResponse: cleanBot,
              strategy: strat,
            });
          }
          continue;
        }

        // 3. DẠNG BẢNG
        if (line.includes('STT |') && line.includes('Bên Đi') && line.includes('Từ Đã Nối')) {
          isAllMovesTable = true;
          isTurnLogsTable = false;
          continue;
        }
        if (line.includes('Lượt |') && line.includes('Từ Đối Thủ') && line.includes('Bot Nối')) {
          isTurnLogsTable = true;
          isAllMovesTable = false;
          continue;
        }
        if (line.startsWith('----+') || line.startsWith('====+') || line.startsWith('-----+')) continue;
        if (line.startsWith('===') || line.startsWith('---') || line.includes('TỔNG KẾT CHIẾN THUẬT')) {
          isAllMovesTable = false;
          isTurnLogsTable = false;
          continue;
        }

        if (isAllMovesTable && line.includes('|')) {
          const cols = line.split('|').map(c => c.trim());
          if (cols.length >= 3 && /^\d+$/.test(cols[0])) {
            const order = parseInt(cols[0], 10);
            const side = cols[1];
            const word = cols[2];
            const strategy = cols[3] || '';
            const latStr = cols[4] || '';
            const latencyMs = parseInt(latStr, 10) || undefined;
            if (word && word !== '—' && !word.includes('❌')) {
              allMoves.push({ order, side, word, strategy, latencyMs });
            }
          }
        } else if (isTurnLogsTable && line.includes('|')) {
          const cols = line.split('|').map(c => c.trim());
          if (cols.length >= 3 && /^\d+$/.test(cols[0])) {
            const oppWord = cols[1];
            const botWord = cols[2];
            const strategy = cols[3] || '';
            const latStr = cols[4] || '';
            const latencyMs = parseInt(latStr, 10) || undefined;

            turnLogs.push({
              opponentWord: (oppWord === '—' || oppWord.includes('❌')) ? '' : oppWord,
              botResponse: (botWord === '—' || botWord.includes('❌')) ? '' : botWord,
              strategy,
              latencyMs,
            });
          }
        }
      }

      // Convert allMoves to turnLogs
      if (allMoves.length > 0 && turnLogs.length === 0) {
        let currentOpp = '';
        for (const move of allMoves) {
          const isOpp = move.side === 'opponent' || move.side.toLowerCase().includes('đối thủ');
          if (isOpp) {
            currentOpp = move.word;
          } else {
            turnLogs.push({
              opponentWord: currentOpp,
              botResponse: move.word,
              strategy: move.strategy,
              latencyMs: move.latencyMs,
            });
            currentOpp = '';
          }
        }
        if (currentOpp) {
          turnLogs.push({ opponentWord: currentOpp, botResponse: '' });
        }
      }

      if (turnLogs.length > 0 || allMoves.length > 0 || fatalWord) {
        matches.push({
          matchId: `txt_match_${sIdx + 1}_${Date.now()}`,
          result: result || 'UNKNOWN',
          opponentName,
          roomCode: roomCode || '/rank',
          fatalWord,
          turnLogs,
          allMoves,
        });
      }
    }

    return matches;
  }

  function parseAndMineMatchLogs(rawInput, fileName = '') {
    let matches = [];
    if (typeof rawInput === 'string') {
      try {
        const parsed = JSON.parse(rawInput);
        return parseAndMineMatchLogs(parsed, fileName);
      } catch (e) {
        const txtMatches = parseTxtMatchLogs(rawInput, fileName);
        return parseAndMineMatchLogs(txtMatches, fileName);
      }
    }
    if (Array.isArray(rawInput)) {
      matches = rawInput;
    } else if (rawInput && typeof rawInput === 'object') {
      if (Array.isArray(rawInput.matches)) {
        matches = rawInput.matches;
      } else if (Array.isArray(rawInput.sessions)) {
        matches = rawInput.sessions;
      } else if (Array.isArray(rawInput.archives)) {
        matches = rawInput.archives;
      } else {
        matches = [rawInput];
      }
    }

    const newKillersMap = new Map();
    const newEscapesMap = new Map();
    const bannedWordsSet = new Set();

    for (const match of matches) {
      if (!match || typeof match !== 'object') continue;
      const turns = extractTurnsFromMatch(match);
      const isLoss = isMatchLoss(match);
      const opponentName = match.opponentName || match.matchMetadata?.opponentName || match.phongDau || 'Cao thủ Noitu';

      // 1. HỌC ĐÒN KẾT LIỄU: Nếu thua, từ cuối của đối thủ là SÁT THỦ!
      if (isLoss && turns.length > 0) {
        let killerWord = '';
        for (let i = turns.length - 1; i >= 0; i--) {
          if (turns[i].opponentWord) {
            killerWord = turns[i].opponentWord;
            break;
          }
        }
        if (!killerWord && match.fatalWord) {
          killerWord = normalizePhrase(match.fatalWord);
        }
        if (killerWord) {
          const parts = killerWord.split(' ');
          if (parts.length === 2) {
            const starter = parts[0];
            const ending = parts[1];
            const DEADLY_KILLER_ENDINGS = new Set([
              'quắp', 'loét', 'hoắt', 'toét', 'bẵng', 'sượt', 'tọt', 'ngoẹo',
              'khiễng', 'khọm', 'rượi', 'choắt', 'nghẽn', 'xoẹo', 'khoèo',
              'khoằm', 'ngoạm', 'ngoắt', 'khuỵu', 'tọp', 'hoắm', 'sũng',
              'huých', 'oằn', 'nhẫy', 'rọm', 'choạng', 'trẹo', 'ngắc',
              'ngớp', 'oặt', 'dẹo', 'khựng', 'bợt', 'phỉnh', 'xoẳn',
              'toác', 'chõng', 'chuếnh', 'khiu', 'uể', 'ẽo', 'ỏn', 'ủn',
              'úp', 'ụt', 'ợt', 'ét', 'ẹt', 'ứt', 'ực', 'đét', 'nhúm', 'lúi',
              'lụi', 'ngoác', 'nhoét', 'hoét', 'hoác', 'khoét', 'quỷnh', 'khoắng'
            ]);

            if (DEADLY_KILLER_ENDINGS.has(ending)) {
              if (!newKillersMap.has(killerWord)) {
                newKillersMap.set(killerWord, {
                  phrase: killerWord,
                  starter,
                  ending,
                  sourceOpponent: opponentName,
                  source: 'noitu.fun',
                  priority: 9999,
                  reason: `Đòn sát thủ của đối thủ "${opponentName}" hạ gục bot trên Noitu.fun (Gậy ông đập lưng ông)`,
                });
              }
            } else {
              if (!newEscapesMap.has(killerWord)) {
                newEscapesMap.set(killerWord, {
                  starter,
                  word: killerWord,
                  ending,
                  resolvedSyllable: starter,
                  sourceOpponent: opponentName,
                  source: 'noitu.fun',
                  priority: 100,
                  reason: `Từ nối thông dụng của đối thủ "${opponentName}" trên Noitu.fun`,
                });
              }
            }
          }
        }
      }

      // 2. HỌC ĐÒN HÓA GIẢI THẾ BÍ (Đối thủ giải được âm khó của mình)
      for (let i = 0; i < turns.length - 1; i++) {
        const myTurn = turns[i];
        const opponentNextTurn = turns[i + 1];
        const myWord = myTurn.botResponse;
        const oppWord = opponentNextTurn.opponentWord;

        if (myWord && oppWord) {
          const myParts = myWord.split(' ');
          const oppParts = oppWord.split(' ');

          if (myParts.length === 2 && oppParts.length === 2) {
            const myEnding = myParts[1];
            const oppStarter = oppParts[0];

            if (myEnding === oppStarter) {
              const escEnding = oppParts[1];
              if (!newEscapesMap.has(oppWord)) {
                newEscapesMap.set(oppWord, {
                  starter: oppStarter,
                  word: oppWord,
                  ending: escEnding,
                  resolvedSyllable: myEnding,
                  sourceOpponent: opponentName,
                  source: 'noitu.fun',
                  priority: 8888,
                  reason: `Lời giải hợp lệ của "${opponentName}" hóa giải âm "${myEnding}" của bot trên Noitu.fun`,
                });
              }
            }
          }
        }
      }

      // 3. LỌC ĐÒN TỰ SÁT (Các từ bot đánh bị lỗi / trừ tim)
      const failed = match.failedWords || match.rawTelemetry?.failedWords || [];
      if (Array.isArray(failed)) {
        for (const w of failed) {
          const clean = normalizePhrase(w);
          if (clean && clean.split(' ').length === 2) bannedWordsSet.add(clean);
        }
      }
      for (const turn of turns) {
        if (turn.isError && turn.botResponse) {
          bannedWordsSet.add(turn.botResponse);
        }
      }
    }

    return {
      newKillers: Array.from(newKillersMap.values()),
      newEscapes: Array.from(newEscapesMap.values()),
      bannedWords: Array.from(bannedWordsSet),
      summary: {
        matchesAnalyzed: matches.length,
        totalKillers: newKillersMap.size,
        totalEscapes: newEscapesMap.size,
        totalBanned: bannedWordsSet.size,
        source: 'noitu.fun',
      }
    };
  }

  class VNTGateway {
    constructor(adapter) {
      this.adapter = adapter;
    }

    async callApi(endpoint, body) {
      const servers = [this.adapter.config.apiServer, this.adapter.config.fallbackServer, this.adapter.config.localServer];
      const headers = {
        'Content-Type': 'application/json',
        'x-api-key': this.adapter.config.vntApiKey || 'VNT-SUPER-BOT-2026',
        'Authorization': `Bearer ${this.adapter.config.vntApiKey || 'VNT-SUPER-BOT-2026'}`,
      };

      const isPost = body !== undefined && body !== null && Object.keys(body).length > 0;
      for (const s of servers) {
        try {
          const res = await this.adapter.fetch(`${s}${endpoint}`, {
            method: isPost ? 'POST' : 'GET',
            headers,
            body: isPost ? JSON.stringify(body) : undefined,
          });
          if (res.ok) return await res.json();
        } catch (e) {}
      }
      return null;
    }

    sendHeartbeat(data) {
      return this.callApi('/api/bot/heartbeat', {
        sessionId: this.adapter.sessionId,
        nodeId: this.adapter.machineId,
        deviceName: this.adapter.deviceName,
        ownerName: typeof GM_getValue === 'function' ? GM_getValue('vuanoitu_owner_name', '') : '',
        apiKey: this.adapter.config.vntApiKey || 'VNT-SUPER-BOT-2026',
        clientIp: this.adapter.publicIp,
        userAgent: navigator.userAgent,
        ...data,
      });
    }

    sendMatchLog(logData) {
      return this.callApi('/api/bot/match-logs', {
        matchId: this.adapter.sessionId,
        deviceName: this.adapter.deviceName,
        ownerName: this.adapter.config.ownerName || '',
        ...logData,
      });
    }

    archiveSession(archivePayload) {
      window.VNT_LAST_MATCH_ARCHIVE = archivePayload;

      // 1. Lưu hồ sơ vào localStorage
      try {
        const rawHistory = localStorage.getItem('vnt_match_history_full');
        const historyList = rawHistory ? JSON.parse(rawHistory) : [];
        historyList.unshift(archivePayload);
        if (historyList.length > 50) historyList.pop();
        localStorage.setItem('vnt_match_history_full', JSON.stringify(historyList));

        // Kiểm đếm tiến độ 30 ván & Tự động tải về máy khi đủ 30 ván
        const autoDownloadEnabled = localStorage.getItem('vnt_auto_download_30_enabled') !== 'false';
        const currentCount = parseInt(localStorage.getItem('vnt_match_count_30') || localStorage.getItem('vnt_match_count_10') || '0', 10) + 1;
        localStorage.setItem('vnt_match_count_30', currentCount.toString());

        const progressEl = document.getElementById('vnt-stat-progress-30') || document.getElementById('vnt-stat-progress-10');
        if (progressEl) progressEl.textContent = `${currentCount % 30}/30`;

        if (autoDownloadEnabled && currentCount >= 30) {
          this.adapter.log('AUTO_EXPORT_30', `🎉 ĐÃ HOÀN THÀNH 30 VÁN ĐẤU! TỰ ĐỘNG XUẤT FILE TỔNG HỢP VỀ MÁY TÍNH...`);
          const last30 = historyList.slice(0, 30);
          const txt30 = format30MatchesReport(last30);
          const filename = `tong_hop_30_van_dau_${Date.now()}.txt`;
          triggerDownloadTxt(filename, txt30);
          localStorage.setItem('vnt_match_count_30', '0');
          if (progressEl) progressEl.textContent = `0/30`;
        }
      } catch (storageErr) {
        this.adapter.warn('STORAGE', 'Lỗi lưu lịch sử match vào localStorage:', storageErr);
      }

      // 2. Gửi hồ sơ lên các Server Gateway
      const servers = [this.adapter.config.apiServer, this.adapter.config.fallbackServer, this.adapter.config.localServer];
      const payloadString = JSON.stringify(archivePayload);
      const blob = new Blob([payloadString], { type: 'application/json' });

      // CƠ CHẾ 1: navigator.sendBeacon — Tuyệt đối không bị hủy khi đổi trang SPA / Requeue
      let beaconSent = false;
      for (const s of servers) {
        try {
          if (typeof navigator !== 'undefined' && navigator.sendBeacon) {
            const ok = navigator.sendBeacon(`${s}/api/bot/archive-session`, blob);
            if (ok) {
              beaconSent = true;
              break;
            }
          }
        } catch (e) {}
      }

      // CƠ CHẾ 2: Fallback fetch với keepalive: true (chuẩn W3C chạy ngầm)
      if (!beaconSent) {
        for (const s of servers) {
          try {
            fetch(`${s}/api/bot/archive-session`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'x-api-key': this.adapter.config.vntApiKey || 'VNT-SUPER-BOT-2026',
              },
              body: payloadString,
              keepalive: true,
            }).catch(() => {});
          } catch (e) {}
        }
      }
    }

    purgeWord(word, reason) {
      this.adapter.warn('PURGE', `Phát hiện từ rác: "${word}" - Game từ chối -> Bắn lệnh XÓA VĨNH VIỄN!`);
      return this.callApi('/api/bot/purge-word', { word, reason: reason || 'Rejected by Noitu.fun' });
    }

    ingestGoldWord(word) {
      this.adapter.log('GOLD', `Đối thủ đánh ra từ "${word}" -> Game chắc chắn công nhận -> NẠP KHO VÀNG!`);
      return this.callApi('/api/bot/ingest-gold-word', { word, source: 'opponent_verified' });
    }

    reportInvalid(word, reason) {
      return this.purgeWord(word, reason);
    }

    aiLearn(fatalSyllable, fullWord, opponent) {
      return this.callApi('/api/bot/ai-learn', { fatalSyllable, fullWord, opponent });
    }

    recordUnsolved(word, opponent) {
      return this.callApi('/api/bot/unsolved', { word, opponent });
    }

    ingestWord(phrase, opponent) {
      return this.callApi('/api/bot/ingest-word', {
        phrase,
        priority_weight: 150,
        opponent: opponent || 'Đối thủ Noitu.fun',
      });
    }

    searchMinimax(starter) {
      return this.callApi(`/api/bot-search?word=${encodeURIComponent(starter)}`, {});
    }

    solveMask(pattern, hint) {
      return this.callApi('/api/bot-solve-mask', { pattern, hint });
    }
  }

  // =========================================================================
  // LỚP 2: CORE GAME STATE MACHINE (FSM — Quản lý Trạng Thái Hữu Hạn)
  // =========================================================================
  const BotState = {
    IDLE: 'IDLE',
    LOBBY_WAITING: 'LOBBY_WAITING',
    OPPONENT_TURN: 'OPPONENT_TURN',
    BOT_TURN: 'BOT_TURN',
    THINKING: 'THINKING',
    EXECUTING: 'EXECUTING',
    VALIDATING: 'VALIDATING',
    MATCH_FINISHED: 'MATCH_FINISHED',
  };

  const VALID_TRANSITIONS = {
    [BotState.IDLE]: [BotState.LOBBY_WAITING, BotState.OPPONENT_TURN, BotState.BOT_TURN],
    [BotState.LOBBY_WAITING]: [BotState.OPPONENT_TURN, BotState.BOT_TURN, BotState.IDLE],
    [BotState.OPPONENT_TURN]: [BotState.BOT_TURN, BotState.MATCH_FINISHED, BotState.LOBBY_WAITING, BotState.IDLE],
    [BotState.BOT_TURN]: [BotState.THINKING, BotState.OPPONENT_TURN, BotState.MATCH_FINISHED, BotState.LOBBY_WAITING, BotState.IDLE],
    [BotState.THINKING]: [BotState.EXECUTING, BotState.OPPONENT_TURN, BotState.MATCH_FINISHED, BotState.LOBBY_WAITING, BotState.IDLE],
    [BotState.EXECUTING]: [BotState.VALIDATING, BotState.OPPONENT_TURN, BotState.MATCH_FINISHED, BotState.LOBBY_WAITING, BotState.IDLE],
    [BotState.VALIDATING]: [BotState.BOT_TURN, BotState.OPPONENT_TURN, BotState.MATCH_FINISHED, BotState.LOBBY_WAITING, BotState.IDLE],
    [BotState.MATCH_FINISHED]: [BotState.LOBBY_WAITING, BotState.IDLE],
  };

  class GameStateMachine {
    constructor(adapter, lexiconEngine, humanizer, gateway) {
      this.adapter = adapter;
      this.lexicon = lexiconEngine;
      this.humanizer = humanizer;
      this.gateway = gateway;

      this.state = BotState.IDLE;
      this.stateEnteredTimestamp = Date.now();
      this.isLocked = false;

      this.matchContext = {
        startTime: 0,
        botTurnCount: 0,
        lastOpponentWord: '',
        trapsUsed: [],
        fallbacksCount: 0,
        discoveredWords: [],
        turnLogs: [],
        allMoves: [],
        lastActivePlayer: 'none',
        usedWords: new Set(),
        lastHeartbeatResult: null,
      };

      this.lastAutoActionTimestamp = 0;
      this.lastObservedUrl = window.location.href;
    }

    isValidTransition(from, to) {
      if (from === to) return true;
      const allowed = VALID_TRANSITIONS[from];
      return Array.isArray(allowed) && allowed.includes(to);
    }

    transition(newState, context = {}) {
      if (this.state === newState) return true;
      if (!this.isValidTransition(this.state, newState)) {
        this.adapter.warn('FSM', `Chuyển trạng thái không hợp lệ: ${this.state} ➔ ${newState}`);
        return false;
      }

      const oldState = this.state;
      this.state = newState;
      this.stateEnteredTimestamp = Date.now();
      this.adapter.log('FSM', `${oldState} ➔ ${newState}`);
      this.onStateChanged(newState, oldState, context);
      return true;
    }

    resetMatchContext() {
      this.matchContext = {
        startTime: Date.now(),
        botTurnCount: 0,
        lastOpponentWord: '',
        trapsUsed: [],
        fallbacksCount: 0,
        discoveredWords: [],
        turnLogs: [],
        allMoves: [],
        lastActivePlayer: 'none',
        usedWords: new Set(),
        isArchived: false,
        lastHeartbeatResult: null,
      };
    }

    flushMatchArchive(resultStatus = 'UNKNOWN') {
      if (this.matchContext.isArchived) return;
      if (this.matchContext.botTurnCount === 0 && this.matchContext.turnLogs.length === 0 && !this.matchContext.lastOpponentWord && this.matchContext.allMoves.length === 0) {
        return;
      }
      this.matchContext.isArchived = true;

      const result = resultStatus.toUpperCase();
      this.matchContext.lastHeartbeatResult = result === 'VICTORY' ? 'win' : (result === 'DEFEAT' ? 'lose' : 'draw');

      // Ghi chú chi tiết đòn kết liễu hoặc nguyên nhân thất bại vào allMoves
      if (result === 'DEFEAT') {
        const lastMove = this.matchContext.allMoves[this.matchContext.allMoves.length - 1];
        if (lastMove && lastMove.side === 'opponent') {
          lastMove.note = '⚡ (Nước cờ chiếu bí của Đối thủ)';
          this.matchContext.allMoves.push({
            order: this.matchContext.allMoves.length + 1,
            side: 'bot',
            word: '❌ (Bot bí từ / Hết giờ)',
            note: 'Không tìm ra từ nối hợp lệ',
            latencyMs: 0,
            timestamp: Date.now(),
          });
        }
      } else if (result === 'VICTORY') {
        const lastMove = this.matchContext.allMoves[this.matchContext.allMoves.length - 1];
        if (lastMove && lastMove.side === 'bot') {
          lastMove.note = '⚡ (ĐÒN KẾT LIỄU: Khiến đối thủ bí từ)';
        }
      }

      const sessionArchivePayload = {
        sessionId: this.adapter.sessionId,
        clientId: (this.adapter.publicIp || 'client').replace(/[^a-zA-Z0-9_-]/g, '_'),
        result,
        startTime: this.matchContext.startTime || (Date.now() - 60000),
        endTime: Date.now(),
        totalTurns: this.matchContext.botTurnCount,
        matchMetadata: {
          startTime: this.matchContext.startTime || (Date.now() - 60000),
          endTime: Date.now(),
          result,
          totalTurns: this.matchContext.botTurnCount,
          roomCode: window.location.pathname,
        },
        tacticsSummary: {
          trapWordsUsed: Array.from(new Set(this.matchContext.trapsUsed)),
          fallbacksTriggered: this.matchContext.fallbacksCount,
          discoveredNewWords: Array.from(new Set(this.matchContext.discoveredWords)),
        },
        turnLogs: [...this.matchContext.turnLogs],
        allMoves: [...this.matchContext.allMoves],
      };

      this.adapter.log('SESSION_ARCHIVE', `💾 Đóng gói gửi hồ sơ lên BFF Gateway (Kết quả: ${result}, ${this.matchContext.botTurnCount} lượt, ${this.matchContext.allMoves.length} nước đi)...`);
      this.gateway.archiveSession(sessionArchivePayload);

      // Gửi sự kiện kết thúc ván vào /api/bot/match-logs để Live Monitor cập nhật ngay lập tức
      this.gateway.sendMatchLog({
        roundIndex: this.matchContext.botTurnCount,
        opponentWord: this.matchContext.lastOpponentWord || '',
        botWord: result === 'VICTORY' ? (this.matchContext.allMoves.filter(m => m.side && m.side.includes('Bot')).pop()?.word || '🏆 Kết liễu đối thủ') : '❌ Bí từ / Hết giờ',
        moveType: 'finish',
        isSuccess: result === 'VICTORY',
        isError: false,
        status: result === 'VICTORY' ? 'win' : (result === 'DEFEAT' ? 'lose' : 'draw'),
        fatalWord: result === 'DEFEAT' ? (this.matchContext.lastOpponentWord || '') : '',
        prediction: {
          winProbability: result === 'VICTORY' ? 100 : 0,
          boardState: result === 'VICTORY' ? 'checkmate' : 'defeated',
          boardStateText: result === 'VICTORY' ? '🏆 CHIẾN THẮNG TUYỆT ĐỐI' : '❌ THẤT BẠI',
          opponentBranches: result === 'VICTORY' ? 0 : 99,
          turnsToKill: 0,
          threatLevel: result === 'VICTORY' ? 'zero' : 'fatal',
        },
      });

      if (result === 'DEFEAT' && this.matchContext.lastOpponentWord) {
        const parts = this.matchContext.lastOpponentWord.trim().split(/\s+/);
        const fatalSyllable = parts[parts.length - 1];
        this.gateway.recordUnsolved(this.matchContext.lastOpponentWord, 'Đối thủ hạ bot');
        this.gateway.aiLearn(fatalSyllable, this.matchContext.lastOpponentWord, 'auto-defeat');
      }
    }

    onStateChanged(newState, oldState, context) {
      switch (newState) {
        case BotState.LOBBY_WAITING:
          this.handleLobbyWaiting();
          break;
        case BotState.BOT_TURN:
          this.handleBotTurn(context);
          break;
        case BotState.MATCH_FINISHED:
          this.handleMatchFinished(context);
          break;
      }
    }

    getGameContainer() {
      return document.querySelector('#main-wrapper') || document.body;
    }

    getRemainingSeconds() {
      const container = this.getGameContainer();
      const timerEl = container.querySelector('[class*="base-timer_timeText"], div[role="timer"], [class*="timeText"]');
      if (timerEl) {
        const sec = parseInt(timerEl.textContent.trim(), 10);
        if (!isNaN(sec)) return sec;
      }
      return 99;
    }

    checkInputErrorState(inputEl) {
      const hasErrorClass = inputEl.classList.contains('inputError') ||
                            Boolean(inputEl.className && inputEl.className.includes('inputError')) ||
                            Boolean(document.querySelector('.anim-shake, [class*="inputError"]'));

      const swalToast = document.querySelector('.swal2-toast, .swal2-container');
      const hasSwalError = swalToast && (
        swalToast.textContent.includes('Không tồn tại') ||
        swalToast.textContent.includes('đã được trả lời') ||
        swalToast.textContent.includes('không có')
      );
      return Boolean(hasErrorClass || hasSwalError);
    }

    extractMaskedPuzzle(container, inputEl) {
      try {
        const placeholder = ((inputEl && inputEl.placeholder) || '').toLowerCase();
        const isFullWordPlaceholder = placeholder.includes('đầy đủ') || placeholder.includes('nhập từ');

        let hintText = '';
        const allTextEls = Array.from(container.querySelectorAll('p, div, span, em, i'));
        for (const el of allTextEls) {
          if (el.closest('#vuanoitu-hud') || el.children.length > 3) continue;
          const txt = (el.textContent || '').trim();
          if (
            txt.length >= 12 &&
            txt.length <= 500 &&
            /(^(động từ|danh từ|tính từ|phó từ|đại từ|từ chỉ)\b|\(1\)|như\s+[a-zA-ZÀ-ỹ])/i.test(txt)
          ) {
            hintText = txt;
            break;
          }
        }

        let extractedPattern = '';
        for (const el of allTextEls) {
          if (el.closest('#vuanoitu-hud')) continue;
          const rawTxt = (el.textContent || '').trim();
          if (rawTxt.length >= 3 && rawTxt.length <= 40 && /[a-zA-ZÀ-ỹ]/.test(rawTxt) && /_/.test(rawTxt)) {
            const childGroups = Array.from(el.children);
            if (childGroups.length >= 2 && childGroups.every((g) => /_/.test(g.textContent || '') || g.children.length >= 2)) {
              const groupMasks = childGroups.map((g) => {
                if (g.children.length >= 2) {
                  return Array.from(g.children)
                    .map((slot) => {
                      const st = (slot.textContent || '').trim();
                      return st && st !== '_' ? st : '_';
                    })
                    .join('');
                }
                return (g.textContent || '').replace(/\s+/g, '');
              });
              extractedPattern = groupMasks.join('   ');
              break;
            }
            extractedPattern = rawTxt;
            break;
          }
        }

        if (!extractedPattern && (isFullWordPlaceholder || hintText)) {
          const wordAreaCandidates = Array.from(
            container.querySelectorAll('[class*="word"], [class*="mask"], [class*="question"], [class*="puzzle"], [class*="card"]')
          );
          for (const area of wordAreaCandidates) {
            if (area.closest('#vuanoitu-hud')) continue;
            const groups = Array.from(area.children).filter(
              (c) => c.tagName === 'DIV' || c.tagName === 'SPAN'
            );
            if (groups.length >= 2 && groups.length <= 4) {
              const sylMasks = [];
              let validStructure = true;
              for (const grp of groups) {
                const slots = Array.from(grp.children);
                if (slots.length < 2 || slots.length > 8) {
                  validStructure = false;
                  break;
                }
                let sMask = '';
                for (const slot of slots) {
                  const ch = (slot.textContent || '').trim().toLowerCase();
                  if (ch.length === 1 && /[a-zA-ZÀ-ỹ]/.test(ch)) {
                    sMask += ch;
                  } else if (ch === '' || ch === '_' || ch === '?') {
                    sMask += '_';
                  } else {
                    validStructure = false;
                    break;
                  }
                }
                if (!validStructure || !sMask.includes('_')) {
                  validStructure = false;
                  break;
                }
                sylMasks.push(sMask);
              }
              if (validStructure && sylMasks.length >= 2) {
                extractedPattern = sylMasks.join('   ');
                break;
              }
            }
          }
        }

        if (!extractedPattern) return null;
        const syllableMasks = this.lexicon.parseMaskPattern(extractedPattern);
        if (syllableMasks.length === 0 || !syllableMasks.some((m) => m.includes('_'))) {
          return null;
        }
        return { pattern: extractedPattern, syllableMasks, hint: hintText };
      } catch (e) {
        return null;
      }
    }

    async handleBotTurn(context) {
      if (this.isLocked) return;
      this.isLocked = true;

      const container = this.getGameContainer();
      const inputEl = container.querySelector('input[class*="word-link-answer-input_input"], input[type="text"]:not(#vnt-mask-input)');
      if (!inputEl || inputEl.disabled || inputEl.readOnly) {
        this.isLocked = false;
        this.transition(BotState.OPPONENT_TURN);
        return;
      }

      // ─── KIỂM TRA CHẾ ĐỘ ĐOÁN TỪ ĐIỀN KHUYẾT (t _ _   r _ _ + GỢI Ý NGHĨA) ───
      const maskedPuzzle = this.extractMaskedPuzzle(container, inputEl);
      if (maskedPuzzle) {
        const maskDisplay = maskedPuzzle.syllableMasks.join('  ');
        const localSolved = this.lexicon.solveMaskedWord(
          maskedPuzzle.pattern,
          maskedPuzzle.hint,
          this.matchContext.usedWords
        );
        let candidates = [...(localSolved.candidates || [])];

        try {
          const remoteRes = await Promise.race([
            this.gateway.solveMask(maskedPuzzle.pattern, maskedPuzzle.hint),
            new Promise((r) => setTimeout(() => r(null), 500)),
          ]);
          if (remoteRes && Array.isArray(remoteRes.candidates) && remoteRes.candidates.length > 0) {
            candidates = Array.from(new Set([...remoteRes.candidates, ...candidates]));
          }
        } catch (e) {}

        if (!this.adapter.config.autoPlay || candidates.length === 0) {
          this.isLocked = false;
          return;
        }

        this.transition(BotState.THINKING, { starterSyllable: maskDisplay, opponentWord: maskDisplay });
        const timeLeft = this.getRemainingSeconds();
        let delayMs = Math.floor(Math.random() * 800) + 1200;
        if (timeLeft <= 4) {
          delayMs = 80;
        } else if (timeLeft < 90) {
          delayMs = Math.min(delayMs, Math.max(100, (timeLeft - 3) * 1000));
        }

        await new Promise((r) => setTimeout(r, delayMs));
        if (!inputEl || inputEl.disabled) {
          this.isLocked = false;
          this.transition(BotState.OPPONENT_TURN);
          return;
        }

        this.transition(BotState.EXECUTING);
        this.matchContext.botTurnCount++;

        for (let idx = 0; idx < Math.min(candidates.length, 6); idx++) {
          const candidate = candidates[idx];
          if (this.getRemainingSeconds() <= 0.8) break;

          this.adapter.log('EXECUTING', `Điền từ khuyết [${maskDisplay}]: "${candidate}"`);
          await this.humanizer.simulateTyping(inputEl, '', candidate, this.adapter.config.typingSpeedMs);
          this.transition(BotState.VALIDATING);
          await new Promise((r) => setTimeout(r, 320));

          if (inputEl.disabled) {
            this.matchContext.usedWords.add(candidate);
            break;
          }
          const hasErr = this.checkInputErrorState(inputEl);
          const stillStuck = (inputEl.value || '').trim().toLowerCase() === candidate.toLowerCase();
          if (!hasErr && !stillStuck) {
            this.matchContext.usedWords.add(candidate);
            break;
          }
          this.humanizer.dispatchNativeInput(inputEl, '');
          await new Promise((r) => setTimeout(r, 150));
        }

        this.isLocked = false;
        this.transition(BotState.OPPONENT_TURN);
        return;
      }

      const wordEl = container.querySelector('[class*="wordWrap"] span, [class*="wordSection"] span, .trans-float-left, .is-size-1');
      let opponentWord = '';
      if (wordEl && wordEl.textContent) {
        const raw = wordEl.textContent.trim().toLowerCase();
        if (raw.length > 0 && !raw.includes('nối từ') && !raw.includes('online')) {
          opponentWord = raw;
        }
      }

      const inputVal = (inputEl.value || '').trim().toLowerCase();
      let starterSyllable = '';
      if (inputVal) {
        starterSyllable = inputVal.split(/\s+/)[0];
      } else if (opponentWord) {
        const parts = opponentWord.split(/\s+/);
        starterSyllable = parts[parts.length - 1];
      }

      if (!starterSyllable) {
        this.isLocked = false;
        return;
      }

      // Lưu từ đối thủ toàn cục để popup và telemetry luôn thấy
      window.VNT_LAST_WORD = opponentWord || starterSyllable || window.VNT_LAST_WORD || '';

      // Ghi nhận nước đi của đối thủ vào allMoves
      if (opponentWord) {
        const oppWordClean = opponentWord.trim().toLowerCase();
        const lastMove = this.matchContext.allMoves[this.matchContext.allMoves.length - 1];
        if (!lastMove || lastMove.word !== oppWordClean) {
          this.matchContext.allMoves.push({
            order: this.matchContext.allMoves.length + 1,
            side: 'opponent',
            word: oppWordClean,
            timestamp: Date.now(),
            note: 'Đối thủ đánh',
          });
        }
      }
      this.matchContext.lastActivePlayer = 'bot';

      this.transition(BotState.THINKING, { starterSyllable, opponentWord });
      const turnStartTimestamp = Date.now();

      // Cào từ đối thủ vào Data Farming & NẠP VÀNG TỨC THÌ (Được game chấp nhận 100%)
      if (opponentWord && opponentWord.split(/\s+/).length >= 2) {
        this.matchContext.usedWords.add(opponentWord);
        if (!this.matchContext.discoveredWords.includes(opponentWord)) {
          this.matchContext.discoveredWords.push(opponentWord);
          this.gateway.ingestGoldWord(opponentWord);
          if (this.adapter.config.dataFarming) {
            this.gateway.ingestWord(opponentWord);
          }
        }
      }

      // 1. Phản xạ phỏng sinh học thích ứng (Human-like Reaction Delay theo yêu cầu):
      // - Chưa nối từ nào (hiệp đầu): Đợi trong vòng 12s tối đa (an toàn 5.5s - 7.0s để không bao giờ bị timeout lượt 10s)
      // - Đã nối <= 3 từ: Đợi dưới 6s (khoảng 3.5s - 4.5s)
      // - Đã nối > 3 từ: Đợi dưới 4s (khoảng 2.2s - 2.8s)
      // (Luôn có safe cap bảo vệ theo đồng hồ timeLeft để không bao giờ bị xử thua do hết giờ)
      const timeLeft = this.getRemainingSeconds();
      const currentWordCount = this.matchContext.botTurnCount;

      let targetDelayMs = 3000;
      if (currentWordCount === 0) {
        // Chưa nối từ nào: giữ nhịp suy nghĩ tự nhiên (5.5s - 7.0s, tối đa dưới 12s)
        targetDelayMs = Math.floor(Math.random() * 1500) + 5500;
        if (timeLeft > 12 && timeLeft < 90) {
          targetDelayMs = Math.min(8500, Math.floor((timeLeft - 3.5) * 1000));
        }
      } else if (currentWordCount <= 3) {
        // Sau 1 đến 3 từ: khoảng 3.5s - 4.5s (dưới 6s)
        targetDelayMs = Math.floor(Math.random() * 1000) + 3500;
      } else {
        // Trên 3 từ: khoảng 2.2s - 2.8s (dưới 4s)
        targetDelayMs = Math.floor(Math.random() * 600) + 2200;
      }

      // Safe Cap: Nếu đồng hồ đếm ngược của game đang chạy và thời gian còn ít,
      // tự động co ngắn delay để bảo đảm gửi từ trước khi hết giờ ít nhất 3.0s!
      let delayMs = targetDelayMs;
      if (timeLeft <= 3.0) {
        delayMs = 80; // Khẩn cấp: phản xạ ngay lập tức để không mất lượt
      } else if (timeLeft < 90) {
        const safeRemainingMs = Math.max(120, Math.floor((timeLeft - 3.0) * 1000));
        delayMs = Math.min(targetDelayMs, safeRemainingMs);
      }

      const delaySecStr = (delayMs / 1000).toFixed(1);
      this.adapter.log('THINKING', `Độ trễ phỏng sinh học [Hiệp ${currentWordCount + 1}]: ${delayMs}ms (${delaySecStr}s) | Timer còn: ${timeLeft}s`);
      await new Promise((r) => setTimeout(r, delayMs));

      if (!inputEl || inputEl.disabled) {
        this.isLocked = false;
        this.transition(BotState.OPPONENT_TURN);
        return;
      }

      let killer1 = null;
      let killer2 = null;
      let safeMove = null;

      try {
        const searchResp = await Promise.race([
          this.gateway.searchMinimax(starterSyllable),
          new Promise((_, reject) => setTimeout(() => reject(new Error('Timeout')), 1200)),
        ]);
        if (searchResp) {
          killer1 = searchResp.killer1;
          killer2 = searchResp.killer2;
          safeMove = searchResp.safeMove;

          // Lọc triệt để: Chống lặp từ trong ván đấu & chống dùng từ đã bị cấm
          if (killer1 && (this.matchContext.usedWords.has(killer1) || this.lexicon.bannedWords.has(killer1))) killer1 = null;
          if (killer2 && (this.matchContext.usedWords.has(killer2) || this.lexicon.bannedWords.has(killer2))) killer2 = null;
          if (safeMove && (this.matchContext.usedWords.has(safeMove) || this.lexicon.bannedWords.has(safeMove))) safeMove = null;
        }
      } catch (e) {}

      // Fallback Trie địa phương nếu server lag hoặc hết từ phù hợp
      if (!killer1 && !safeMove) {
        const local = this.lexicon.getCandidates(starterSyllable, this.matchContext.usedWords);
        killer1 = local.killer1;
        killer2 = local.killer2;
        safeMove = local.safeMove;
      }

      if (!safeMove) safeMove = killer1 || killer2 || null;
      if (!safeMove && typeof window !== 'undefined' && window.VNT_LEXICON && window.VNT_LEXICON[starterSyllable]) {
        const fallbackEndings = window.VNT_LEXICON[starterSyllable];
        if (Array.isArray(fallbackEndings) && fallbackEndings.length > 0) {
          safeMove = `${starterSyllable} ${fallbackEndings[0]}`;
        }
      }

      this.transition(BotState.EXECUTING);
      this.matchContext.botTurnCount++;
      this.matchContext.lastOpponentWord = opponentWord;

      const executeAttempt = async (wordToTry, moveType) => {
        if (!wordToTry) return false;
        const tokens = wordToTry.trim().split(/\s+/);
        const secondWord = tokens[1];
        if (!secondWord) return false;

        this.adapter.log('EXECUTING', `Xuất đòn (${moveType.toUpperCase()}): "${wordToTry}" (Âm 2: "${secondWord}")`);
        await this.humanizer.simulateTyping(inputEl, starterSyllable, secondWord, this.adapter.config.typingSpeedMs);

        this.transition(BotState.VALIDATING);
        await new Promise((r) => setTimeout(r, 350));

        // Kiểm tra xem từ đã thực sự gửi đi chưa
        const currentVal = (inputEl.value || '').trim().toLowerCase();
        const expectedVal = `${starterSyllable} ${secondWord}`.trim().toLowerCase();
        if (currentVal === expectedVal && !inputEl.disabled) {
          const retryBtn = inputEl.parentElement?.querySelector('button') ||
                           document.querySelector('button[class*="word-link-answer-input_btn"]') ||
                           document.querySelector('button[aria-label*="Gửi"], button[aria-label*="gửi"]');
          if (retryBtn && !retryBtn.disabled) {
            this.adapter.warn('EXECUTING', `Từ "${expectedVal}" chưa gửi -> Kích hoạt bấm nút cưỡng bức!`);
            this.humanizer.triggerButtonClick(retryBtn);
            this.humanizer.triggerEnter(inputEl);
            await new Promise((r) => setTimeout(r, 300));
          }
        }

        const hasError = this.checkInputErrorState(inputEl);
        if (hasError) {
          this.adapter.warn('VALIDATING', `Từ bị hệ thống từ chối (${moveType}): "${wordToTry}" -> XÓA VĨNH VIỄN!`);
          this.lexicon.banWord(wordToTry);
          this.gateway.purgeWord(wordToTry, `Noitu.fun từ chối (${moveType})`);

          this.humanizer.dispatchNativeInput(inputEl, `${starterSyllable} `);
          await new Promise((r) => setTimeout(r, 200));
          return false;
        }

        // Thành công! Đánh dấu từ đã sử dụng để chống lặp từ
        this.matchContext.usedWords.add(wordToTry);

        const latencyMs = Math.max(10, Date.now() - turnStartTimestamp);
        let strategy = moveType === 'killer1' ? 'AGGRESSIVE' : (moveType === 'killer2' ? 'CONSTRICTION' : 'DEFENSIVE');
        if (this.lexicon.learnedKillers && this.lexicon.learnedKillers.has(wordToTry)) {
          strategy = 'AI_REPLAY_KILLER';
        } else if (this.lexicon.learnedEscapes && (this.lexicon.learnedEscapes.get(starterSyllable) || []).includes(wordToTry)) {
          strategy = 'AI_REPLAY_ESCAPE';
        }
        if (moveType === 'killer1' || moveType === 'killer2') {
          this.matchContext.trapsUsed.push(wordToTry);
        } else {
          this.matchContext.fallbacksCount++;
        }

        // Ghi lại vào allMoves
        this.matchContext.allMoves.push({
          order: this.matchContext.allMoves.length + 1,
          side: 'bot',
          word: wordToTry,
          strategy,
          latencyMs,
          timestamp: Date.now(),
          note: strategy === 'AGGRESSIVE' ? 'Đòn Sát Thủ (Killer)' : 'Phản đòn',
        });
        this.matchContext.lastActivePlayer = 'opponent';

        this.matchContext.turnLogs.push({
          step: this.matchContext.botTurnCount,
          opponentWord: opponentWord || starterSyllable,
          botResponse: wordToTry,
          strategy,
          latencyMs,
        });

        const endingSyllable = (wordToTry.split(/\s+/).pop() || '').toLowerCase();
        const isLethalEnding = this.lexicon.killerEndings.includes(endingSyllable);
        const oppNextCount = (opponentNextOptions && opponentNextOptions.length) ? opponentNextOptions.length : 0;
        const winProb = isLethalEnding ? 99 : (oppNextCount <= 2 ? 88 : (oppNextCount <= 5 ? 78 : 70));
        const boardState = isLethalEnding ? 'checkmate' : (oppNextCount <= 2 ? 'constriction' : 'balanced');
        const boardStateText = isLethalEnding ? '🎯 Chiếu Bí Tuyệt Đối' : (oppNextCount <= 2 ? '⚡ Siết Chặt Vòng Vây' : '🛡️ Điều Tiết Thế Trận');
        const prediction = {
          winProbability: winProb,
          boardState,
          boardStateText,
          opponentBranches: oppNextCount,
          turnsToKill: isLethalEnding ? 1 : (oppNextCount <= 2 ? '1 - 2' : '2 - 4'),
          threatLevel: moveType === 'safe' ? 'medium' : 'low',
          targetSyllable: endingSyllable,
        };

        this.gateway.sendMatchLog({
          opponentWord: opponentWord || starterSyllable,
          botWord: wordToTry,
          moveType,
          isSuccess: true,
          status: 'playing',
          roundIndex: this.matchContext.botTurnCount,
          prediction,
        });

        return true;
      };

      const timeLeftNow = this.getRemainingSeconds();

      // NẾU THỜI GIAN <= 2.5s -> CẮT BƯỚC NHẢY THẲNG SAFE
      if (timeLeftNow <= 2.5) {
        this.adapter.log('TIME_BUDGET', `Thời gian cạn (${timeLeftNow}s <= 2.5s) -> Nhảy thẳng Tier 3 Safe 100%!`);
        await executeAttempt(safeMove, 'safe');
        this.isLocked = false;
        this.transition(BotState.OPPONENT_TURN);
        return;
      }

      let success = false;
      if (killer1 && this.adapter.config.prioritizeKillers) {
        success = await executeAttempt(killer1, 'killer1');
      }

      if (!success && killer2 && killer2 !== killer1 && this.adapter.config.prioritizeKillers) {
        await new Promise((r) => setTimeout(r, 250));
        const timeLeft2 = this.getRemainingSeconds();
        if (timeLeft2 > 2.0) {
          success = await executeAttempt(killer2, 'killer2');
        }
      }

      // BƯỚC 3: Hạ cánh an toàn & Thử danh sách ứng viên Safe (Multi-Fallback Recovery)
      if (!success) {
        await new Promise((r) => setTimeout(r, 250));
        const candidateSafes = (local.safes && local.safes.length > 0) ? local.safes : [safeMove];
        for (const candidate of candidateSafes) {
          const timeLeftFallback = this.getRemainingSeconds();
          if (timeLeftFallback <= 0.8) break;
          success = await executeAttempt(candidate, 'safe');
          if (success) break;
        }
      }

      // BƯỚC 4: Fallback tối hậu nếu tất cả đều trượt
      if (!success) {
        await executeAttempt(safeMove, 'safe');
      }

      this.isLocked = false;
      this.transition(BotState.OPPONENT_TURN);
    }

    handleMatchFinished(context) {
      const { result = 'VICTORY', endReason = '' } = context;
      this.adapter.log('MATCH_FINISHED', `Trận đấu kết thúc: [${result}] - ${endReason}`);
      this.matchContext.endReason = endReason;
      this.flushMatchArchive(result);
      this.resetMatchContext();
    }

    handleLobbyWaiting() {
      if (!this.adapter.config.autoRequeue) return;
      const now = Date.now();
      if (now - this.lastAutoActionTimestamp < 800) return;

      const playAgainBtn = document.querySelector('button.game-result-modal_actionBtn__iaBAh.game-result-modal_primary__JpKaz') ||
                           document.querySelector('button[class*="game-result-modal"][class*="primary"]') ||
                           Array.from(document.querySelectorAll('button')).find((b) => {
                             const txt = (b.textContent || '').trim().toLowerCase();
                             return !b.disabled && (txt.includes('chơi lại') || txt.includes('tìm trận') || txt.includes('tái đấu'));
                           });

      if (playAgainBtn && !playAgainBtn.disabled) {
        this.lastAutoActionTimestamp = now;
        this.adapter.log('LOBBY', 'Tự động bấm [Chơi Lại] tiếp tục leo rank...');
        playAgainBtn.click();
        return;
      }

      if (window.location.pathname.startsWith('/rank')) {
        const isSearching = Boolean(
          document.body.innerText.includes('Đang tìm trận') ||
          document.body.innerText.includes('Đang tìm đối thủ')
        );
        if (isSearching) return;

        const wordLinkCard = document.querySelector('button.mode-picker_modeCardWordLink__2xaJ4') ||
                             Array.from(document.querySelectorAll('button, div[role="button"]')).find((b) => {
                               const txt = b.textContent || '';
                               return txt.includes('Nối Từ') && !txt.includes('Mở Rộng');
                             });

        if (wordLinkCard && !wordLinkCard.disabled) {
          this.lastAutoActionTimestamp = now;
          this.adapter.log('LOBBY', 'Tự động chọn chế độ [Nối Từ] tìm trận mới...');
          wordLinkCard.click();
          return;
        }
      }

      const readyBtn = document.querySelector('.game-preparation_ready___DOid, button[class*="ready"]') ||
                       Array.from(document.querySelectorAll('button')).find((b) => b.textContent.trim().toLowerCase() === 'sẵn sàng');
      if (readyBtn && !readyBtn.disabled) {
        this.lastAutoActionTimestamp = now;
        this.adapter.log('LOBBY', 'Tự động bấm [Sẵn Sàng]...');
        readyBtn.click();
      }
    }

    evaluateDOM() {
      const container = this.getGameContainer();
      const inputEl = container.querySelector('input[class*="word-link-answer-input_input"], input[type="text"]');
      const wordEl = container.querySelector('[class*="wordWrap"] span, [class*="wordSection"] span, .trans-float-left, .is-size-1');
      const timerEl = container.querySelector('[class*="base-timer_timeText"], div[role="timer"], [class*="timeText"]');
      const hasResultModal = Boolean(document.querySelector('[class*="game-result-modal"], [class*="result-modal"]'));

      const isMatchActive = Boolean(inputEl || wordEl || timerEl);

      // 1. Kiểm tra màn hình kết quả ván đấu (Thắng / Thua / Đối thủ rời / Hết giờ)
      const bodyText = (document.body.innerText || '').toLowerCase();
      const hasDirectResultText = (
        bodyText.includes('chiến thắng') ||
        bodyText.includes('bạn thắng') ||
        bodyText.includes('đối thủ đã rời') ||
        bodyText.includes('đối thủ đã thoát') ||
        bodyText.includes('thất bại') ||
        bodyText.includes('bạn thua') ||
        bodyText.includes('bị xử thua')
      );

      if (hasResultModal || (hasDirectResultText && !isMatchActive)) {
        if (this.state !== BotState.MATCH_FINISHED) {
          const outcome = detectMatchOutcome(container, this.matchContext.lastActivePlayer, this.matchContext);
          this.transition(BotState.MATCH_FINISHED, { result: outcome.result, endReason: outcome.reason });
        }
        this.handleLobbyWaiting();
        return;
      }

      // 2. Kiểm tra sảnh chờ hoặc phòng chờ (CHỈ KHI KHÔNG TRONG TRẬN ĐẤU)
      if ((window.location.pathname === '/rank' || window.location.pathname === '/online') && !isMatchActive) {
        if (!this.matchContext.isArchived && (this.matchContext.botTurnCount > 0 || this.matchContext.allMoves.length > 0)) {
          const outcome = detectMatchOutcome(container, this.matchContext.lastActivePlayer, this.matchContext);
          this.flushMatchArchive(outcome.result);
          this.resetMatchContext();
        }
        if (this.state !== BotState.LOBBY_WAITING) {
          this.transition(BotState.LOBBY_WAITING);
        }
        this.handleLobbyWaiting();
        return;
      }

      if (inputEl && !inputEl.disabled && !inputEl.readOnly) {
        if (this.state !== BotState.BOT_TURN && this.state !== BotState.THINKING && this.state !== BotState.EXECUTING && this.state !== BotState.VALIDATING) {
          this.transition(BotState.BOT_TURN);
        }
      } else {
        if (this.state !== BotState.OPPONENT_TURN && this.state !== BotState.THINKING && this.state !== BotState.EXECUTING && this.state !== BotState.VALIDATING) {
          this.transition(BotState.OPPONENT_TURN);
        }
      }
    }
  }

